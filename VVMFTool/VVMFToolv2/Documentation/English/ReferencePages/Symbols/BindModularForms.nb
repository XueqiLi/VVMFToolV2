Notebook[{Cell["BindModularForms", "ObjectName"], 
  Cell["BindModularForms[m, <|slotID -> y, ...|>] binds Stage 7 modular forms \
to formal slots of the modular model m as frozen snapshots, after exact \
compatibility, validation and independence checks.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["BindModularForms[m, <|slotID -> y, \
...|>] binds Stage 7 forms to registered slots as frozen snapshots after \
exact compatibility (group, generators, assignment, basis, representation, \
weight), holomorphy at the cusp, resolved coefficients, a passed Stage 7 S/T \
check (finite jets are sampled at their explicit SeriesOrder) and \
independence checks.", "Notes"], Cell["Options: ReplaceBindings, \
RequireProof, WorkingPrecision, SeriesOrder, TimeLimit. Later updates of y do \
not change the model.", "Notes"], Cell["No implemented route produces Proven \
at present (there is no exact identity certificate, and the S check is \
sampled), so RequireProof -> True currently refuses every form and model \
result with ProofRequired.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ReplaceBindings"], "TableText"], 
       Cell["False", "TableText"], Cell["False (default) fails AlreadyBound; \
True replaces them and checks the combined bound set of every affected space \
again.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["RequireProof"], "TableText"], 
       Cell["False", "TableText"], Cell["False (default) or True: a result \
that is not Proven (numerical fits, verified reconstructions, sampled checks) \
fails with ProofRequired.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["WorkingPrecision"], "TableText"], 
       Cell["40", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["SeriesOrder"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic (default: chosen from \
the accuracy goal and the point, or 6 orders for construction checks) or a \
positive integer; an explicit order is required to evaluate a finite jet (the \
result then has EstimatedError Missing[\"NoTailBound\"] or the next-order \
difference).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["TimeLimit"], "TableText"], Cell["600", "TableText"], 
       Cell["600 (default), a positive number or Infinity; exceeding it fails \
with TimeLimit and changes nothing.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["Verification"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic, \"Exact\", \
\"Numerical\" or None (the Validate functions: Automatic, \"Exact\" or \
\"Numerical\"; the modular-form functions have no \"Exact\" route).", 
        "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     GridBoxItemSize -> {"Columns" -> {Scaled[0.02], Scaled[0.3], 
         Scaled[0.18], Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormBindings", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormBindings.nb", None}], "  |  ", 
     ButtonBox["ValidateModularModel", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ValidateModularModel.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "c", ",", "d", ",", "one", ",", "df", ",", "rf", ",", 
            "m0"}], "}"}], ",", RowBox[{RowBox[{"AssignModularGenerators", 
            "[", RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"c", "=", RowBox[{"RepresentationContext", "[", "g", 
              "]"}]}], ";", RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"one", "=", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", 
                "]"}], "[", "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"df", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "d", ",", "\"D\""}], "]"}]}], ";", 
          RowBox[{"rf", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "one", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m0", "=", RowBox[{"CreateModularModel", "[", 
              RowBox[{"c", ",", RowBox[{"{", RowBox[{"df", ",", "rf"}], 
                  "}"}], ",", RowBox[{"FieldWeights", "\[Rule]", 
                  RowBox[{"Association", "[", RowBox[{RowBox[{RowBox[{"df", 
                          "[", "\"ID\"", "]"}], "\[Rule]", "1"}], ",", 
                      RowBox[{RowBox[{"rf", "[", "\"ID\"", "]"}], "\[Rule]", 
                        "1"}]}], "]"}]}]}], "]"}]}], ";", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"m", "=", RowBox[{"AddModelTerm", "[", RowBox[
                       {"m0", ",", RowBox[{"CoupleContractions", "[", 
                          RowBox[{"ModularContractions", "[", RowBox[{"m0", 
                          ",", RowBox[{"{", RowBox[{"df", ",", "rf"}], 
                          "}"}]}], "]"}], "]"}]}], "]"}]}], ",", 
                  RowBox[{"y", "=", RowBox[{"First", "[", RowBox[
                       {"ConstructModularForms", "[", RowBox[{"c", ",", 
                          "d"}], "]"}], "]"}]}], ",", "slot", ",", "mb", ",", 
                  "values"}], "}"}], ",", RowBox[{RowBox[
                 {"ModularFormGetCoeff", "[", RowBox[{"y", ",", RowBox[
                     {"WorkingPrecision", "\[Rule]", "30"}]}], "]"}], ";", 
                RowBox[{"slot", "=", RowBox[{"First", "[", RowBox[{"Keys", 
                      "[", RowBox[{RowBox[{RowBox[{"First", "[", "m", "]"}], 
                          "[", "\"ModularData\"", "]"}], "[", "\"Slots\"", 
                        "]"}], "]"}], "]"}]}], ";", RowBox[{"mb", "=", 
                  RowBox[{"BindModularForms", "[", RowBox[{"m", ",", 
                      RowBox[{"Association", "[", RowBox[{"slot", "\[Rule]", 
                          "y"}], "]"}]}], "]"}]}], ";", RowBox[{"values", 
                  "=", RowBox[{"AssociationThread", "[", RowBox[
                     {RowBox[{"Lookup", "[", RowBox[{RowBox[
                          {"ModelParameters", "[", "mb", "]"}], ",", 
                          "\"ID\""}], "]"}], ",", RowBox[{"ConstantArray", 
                        "[", RowBox[{"1", ",", RowBox[{"Length", "[", RowBox[
                          {"ModelParameters", "[", "mb", "]"}], "]"}]}], 
                        "]"}]}], "]"}]}], ";", RowBox[{RowBox[
                   {RowBox[{"ValidateModularModel", "[", "mb", "]"}], "[", 
                    "\"Binding\"", "]"}], "[", "\"Status\"", "]"}]}]}], 
            "]"}]}]}], "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["\"Full\""], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"BindModularForms", "[", 
        RowBox[{"1", ",", RowBox[{"Association", "[", "]"}]}], "]"}], "]"}]], 
   "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/BindModularForms", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "BindModularForms \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
