Notebook[{Cell["RepresentationMethod", "ObjectName"], 
  Cell["RepresentationMethod selects one representation construction route, \
or Automatic for the unitary-first phases.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Option for \
ComputeGroupRepresentations and the builders (BuildGroup, BuildModularGroup, \
BuildGroupFromGAP). Default: Automatic.", "Notes"], 
  Cell["Automatic, \"SL2Reps\", \"LinearCharacter\", \"DixonUnitary\", \
\"BaumClausen\", \"InducedUnitary\", \"Dixon\", \"REPSN\", \
\"CharacterSubgroup\", \"Induction\", \"Extension\", \"NormalExtension\", \
\"AtlasRep\" or \"GAP\". Automatic runs direct unitary routes before general \
ones; every result is verified on the actual group.", "Notes"], 
  Cell["Per-call setting; not part of the package configuration.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ComputeGroupRepresentations", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"ComputeGroupRepresentations.nb", None}], "  |  ", 
     ButtonBox["MethodData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"MethodData.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", 
            "ComputeGroupRepresentations", "]"}]}], ",", 
        "RepresentationMethod"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/RepresentationMethod", "Categorization", 
