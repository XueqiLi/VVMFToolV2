Notebook[{Cell["RepresentationContext", "ObjectName"], 
  Cell["RepresentationContext[g] returns an immutable snapshot of the \
accepted group g's generators, characters, modular assignment and \
representation data. context[\"field\"] reads a field.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["RepresentationContext[g] freezes the \
accepted group's GroupIdentity, GeneratorIdentity, GeneratorIDs, \
GeneratorNames, Order, Construction, StateGeneration, CharacterData, \
ModularAssignment and Representations. context[\"Field\"] reads a field.", 
   "Notes"], Cell["The snapshot is immutable: later changes to the group, \
such as a new modular assignment, do not change it. A copy of a context \
remains valid in the kernel where it was bound; an altered snapshot is not \
accepted by group-aware operations.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["SRep", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SRep.nb", None}], "  |  ", ButtonBox["TRep", 
      BaseStyle -> "Hyperlink", ButtonData -> {"TRep.nb", None}], "  |  ", 
     ButtonBox["Group", BaseStyle -> "Hyperlink", 
      ButtonData -> {"Group.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"CatalogueGroup", "[", RowBox[
                     {"\"CyclicGroup\"", ",", "3"}], "]"}], ",", 
                  RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], 
                  ",", RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], 
                "]"}]}], ",", "c"}], "}"}], ",", 
        RowBox[{RowBox[{"c", "=", RowBox[{"RepresentationContext", "[", "g", 
              "]"}]}], ";", RowBox[{"{", RowBox[{RowBox[{"c", "[", 
                "\"Order\"", "]"}], ",", RowBox[{"c", "[", 
                "\"GeneratorNames\"", "]"}], ",", RowBox[{"c", "[", 
                "\"ModularAssignment\"", "]"}]}], "}"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"3", ",", RowBox[{"{", "\"g1\"", "}"}], 
        ",", RowBox[{"Missing", "[", "\"NotAssigned\"", "]"}]}], "}"}]], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"RepresentationContext", "[", 
        "3", "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/RepresentationContext", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "RepresentationContext \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
