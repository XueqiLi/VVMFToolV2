Notebook[{Cell["ChannelPolicy", "ObjectName"], Cell["ChannelPolicy selects \
the channels CoupleContractions couples: \"Independent\" (default) or \
\"AllChannels\".", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for CoupleContractions: which channels receive couplings. \
\"Independent\" couples one basis polynomial per independent channel; \
\"AllChannels\" couples every provably nonzero channel and reports the linear \
dependencies in the term's Relations.", "Notes"], 
  Cell["\"Independent\" (default) or \"AllChannels\".", "Notes"], 
  Cell["Other values fail with InvalidOption before any computation.", 
   "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["CoupleContractions", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CoupleContractions.nb", None}], "  |  ", 
     ButtonBox["IndependentContractions", BaseStyle -> "Hyperlink", 
      ButtonData -> {"IndependentContractions.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"t", ",", "m2", ",", "q", ",", "raw", ",", 
            "x", ",", "mass", ",", RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "sign", ",", "l", ",", "r", ",", "m"}], "}"}], 
        ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"sign", "=", RowBox[{"First", "[", RowBox[{"DeleteCases", 
                "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                        "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                         {RowBox[{"RepDim", "[", RowBox[
                          {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "1"}], "&"}]}], "]"}], 
                  ",", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", "]"}], 
                    "[", "\"TrivialIrrepID\"", "]"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"q", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", "l", "}"}]}], "]"}]}], ";", 
          RowBox[{"raw", "=", RowBox[{"Contractions", "[", RowBox[{"q", ",", 
                RowBox[{"{", RowBox[{"l", ",", "l", ",", "l", ",", "l"}], 
                  "}"}]}], "]"}]}], ";", RowBox[
           {"{", RowBox[{RowBox[{"Length", "[", RowBox[{"CouplingParameters", 
                  "[", RowBox[{"CoupleContractions", "[", "raw", "]"}], 
                  "]"}], "]"}], ",", RowBox[{"Length", "[", RowBox[
                 {"CouplingParameters", "[", RowBox[{"CoupleContractions", 
                    "[", RowBox[{"raw", ",", RowBox[{"ChannelPolicy", 
                        "\[Rule]", "\"AllChannels\""}]}], "]"}], "]"}], 
                "]"}]}], "}"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"1", ",", "2"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"t", ",", "m2", ",", "q", ",", "raw", ",", 
            "x", ",", "mass", ",", RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "sign", ",", "l", ",", "r", ",", "m"}], "}"}], 
        ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"sign", "=", RowBox[{"First", "[", RowBox[{"DeleteCases", 
                "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                        "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                         {RowBox[{"RepDim", "[", RowBox[
                          {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "1"}], "&"}]}], "]"}], 
                  ",", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", "]"}], 
                    "[", "\"TrivialIrrepID\"", "]"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"q", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", "l", "}"}]}], "]"}]}], ";", 
          RowBox[{"raw", "=", RowBox[{"Contractions", "[", RowBox[{"q", ",", 
                RowBox[{"{", RowBox[{"l", ",", "l", ",", "l", ",", "l"}], 
                  "}"}]}], "]"}]}], ";", RowBox[{"FailureQ", "[", 
            RowBox[{"CoupleContractions", "[", RowBox[{"raw", ",", 
                RowBox[{"ChannelPolicy", "\[Rule]", "\"Some\""}]}], "]"}], 
            "]"}]}]}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ChannelPolicy", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "ChannelPolicy \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
