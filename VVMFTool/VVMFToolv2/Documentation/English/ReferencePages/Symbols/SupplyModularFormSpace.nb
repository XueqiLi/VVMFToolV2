Notebook[{Cell["SupplyModularFormSpace", "ObjectName"], 
  Cell["SupplyModularFormSpace[m, {y1, ...}] establishes, for the modular \
model m, the space of the forms' irrep and weight from the supplied \
independent forms when Stage 7 has no count (for example a rational weight on \
a cover of SL(2,Z)); the space gets status Supplied and slots, and a model \
using it is never Proven.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["SupplyModularFormSpace[m, {y1, ...}] establishes the space of the \
forms' irrep and weight for the modular model m from the supplied forms, when \
Stage 7 has no count for it: a rational weight on a cover of SL(2,Z) (a group \
with S^2 central and (ST)^3 = S^4, for example Z_24 = <T> with S = T^3, which \
carries eta of weight 1/2) has Missing[\"UnknownDimension\"]. The space gets \
Status \"Supplied\", dimension Length[{y1, ...}] and slots, so \
ModularFormCandidates and ModularContractions can use it.", "Notes"], 
  Cell["The forms must have one irrep and one weight, fit the model's context \
exactly (group, assignment, basis, representation), be holomorphic at the \
cusp, pass their Stage 7 S/T check and be independent by q-coefficient rank. \
The spanning claim itself is the user's: a model that uses a supplied space \
is never Proven (ValidateModularModel reports \"Established\" -> \
\"Supplied\"), and its contractions, terms and model report \
\"VerificationStatus\" \"Unverified\". The forms are not bound; bind them \
with BindModularForms.", "Notes"], Cell["A space Stage 7 counts is refused \
(EstablishedSpace); a supplied space that already has slots in the model is \
refused (SuppliedSpaceInUse). Options WorkingPrecision, SeriesOrder, \
TimeLimit. Model archives keep the supplied spaces as the user's claim (the \
supplying forms are not archived, so their independence is not recomputed on \
import). If Stage 7 later counts the space, the count wins. FormSlotTable \
marks such a space dimension \"(supplied)\".", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["WorkingPrecision"], "TableText"], 
       Cell["40", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["SeriesOrder"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic (default: chosen from \
the accuracy goal and the point, or 6 orders for construction checks) or a \
positive integer; an explicit order is required to evaluate a finite jet (the \
result then has EstimatedError Missing[\"NoTailBound\"] or the next-order \
difference).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["TimeLimit"], "TableText"], Cell["600", "TableText"], 
       Cell["600 (default), a positive number or Infinity; exceeding it fails \
with TimeLimit and changes nothing.", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BindModularForms", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BindModularForms.nb", None}], "  |  ", 
     ButtonBox["ModularFormCandidates", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormCandidates.nb", None}], "  |  ", 
     ButtonBox["CreateModularForm", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CreateModularForm.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{
                "BuildModularGroup", "[", RowBox[{RowBox[
                   {"GroupPresentation", "[", RowBox[{RowBox[{"{", RowBox[
                         {"\"S\"", ",", "\"T\""}], "}"}], ",", RowBox[
                       {"{", RowBox[{"\"T^24\"", ",", "\"S.T^-3\""}], 
                        "}"}]}], "]"}], ",", RowBox[{"StoreGAPState", 
                    "\[Rule]", "False"}]}], "]"}]}], ",", "c", ",", "eta", 
            ",", "conj", ",", "l", ",", "r", ",", "m"}], "}"}], ",", 
        RowBox[{RowBox[{"c", "=", RowBox[{"RepresentationContext", "[", "g", 
              "]"}]}], ";", RowBox[{"eta", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RootReduce", "[", RowBox[{RowBox[{"First", 
                          "[", RowBox[{"Flatten", "[", RowBox[
                          {"RepresentationElementMatrices", "[", RowBox[
                          {"g", ",", "#1", ",", RowBox[{"{", RowBox[
                          {"GroupWord", "[", "\"T\"", "]"}], "}"}]}], "]"}], 
                          "]"}], "]"}], "-", SuperscriptBox[RowBox[{"(", 
                          RowBox[{"-", "1"}], ")"}], RowBox[{"1", "/", 
                          "12"}]]}], "]"}], "===", "0"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"conj", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RootReduce", "[", RowBox[{RowBox[{"First", 
                          "[", RowBox[{"Flatten", "[", RowBox[
                          {"RepresentationElementMatrices", "[", RowBox[
                          {"g", ",", "#1", ",", RowBox[{"{", RowBox[
                          {"GroupWord", "[", "\"T\"", "]"}], "}"}]}], "]"}], 
                          "]"}], "]"}], "-", SuperscriptBox[RowBox[{"(", 
                          RowBox[{"-", "1"}], ")"}], RowBox[{RowBox[{"-", 
                          "1"}], "/", "12"}]]}], "]"}], "===", "0"}], 
                    "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "conj", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                RowBox[{RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
                  "\"TrivialIrrepID\"", "]"}], ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModularModel", "[", 
              RowBox[{"c", ",", RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}], 
                ",", RowBox[{"FieldWeights", "\[Rule]", RowBox[
                   {"Association", "[", RowBox[{RowBox[{RowBox[{"l", "[", 
                          "\"ID\"", "]"}], "\[Rule]", FractionBox["1", 
                         "4"]}], ",", RowBox[{RowBox[{"r", "[", "\"ID\"", 
                          "]"}], "\[Rule]", FractionBox["1", "4"]}]}], 
                    "]"}]}]}], "]"}]}], ";", RowBox[{"m", "=", 
            RowBox[{"SupplyModularFormSpace", "[", RowBox[{"m", ",", 
                RowBox[{"{", RowBox[{"CreateModularForm", "[", RowBox[
                     {"g", ",", "eta", ",", FractionBox["1", "2"], ",", 
                      RowBox[{"ModularFormDefinition", "[", RowBox[
                         {RowBox[{"{", RowBox[{"ScalarModularExpression", 
                          "[", RowBox[{"\"Eta\"", ",", "q"}], "]"}], "}"}], 
                          ",", "q"}], "]"}]}], "]"}], "}"}]}], "]"}]}], ";", 
          RowBox[{RowBox[{"(", RowBox[{RowBox[{"{", RowBox[{RowBox[{"#1", 
                      "[", "\"Weight\"", "]"}], ",", RowBox[{"#1", "[", 
                      "\"Copy\"", "]"}]}], "}"}], "&"}], ")"}], "/@", 
            RowBox[{RowBox[{"ModularFormCandidates", "[", RowBox[{"m", ",", 
                  RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}], "[", 
              "\"Slots\"", "]"}]}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"{", RowBox[{FractionBox["1", "2"], ",", 
          "1"}], "}"}], "}"}]], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"SupplyModularFormSpace", 
        "[", RowBox[{"1", ",", RowBox[{"{", "}"}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/SupplyModularFormSpace", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "SupplyModularFormSpace \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
