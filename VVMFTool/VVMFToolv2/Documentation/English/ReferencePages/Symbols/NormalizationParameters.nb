Notebook[{Cell["NormalizationParameters", "ObjectName"], 
  Cell["NormalizationParameters is an option of ModularFormDefinition: the \
coefficient symbols of the definition, captured held as FormParameter atoms."\
, "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option of ModularFormDefinition: the coefficient symbols of the \
definition, captured held and lowered to FormParameter atoms of the \
definition's family.", "Notes"], Cell["{} (default) or a duplicate-free list \
of symbols or indexed atoms, distinct from the variable. Patterns and package \
atoms fail with InvalidOption; values assigned to the symbols never enter the \
definition.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormDefinition", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormDefinition.nb", None}], "  |  ", 
     ButtonBox["FormParameter", BaseStyle -> "Hyperlink", 
      ButtonData -> {"FormParameter.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Lookup", "[", 
      RowBox[{RowBox[{RowBox[{"First", "[", RowBox[{"ModularFormDefinition", 
              "[", RowBox[{RowBox[{"{", RowBox[{RowBox[{"a", " ", "q"}], "+", 
                    RowBox[{"b", " ", SuperscriptBox["q", "2"]}]}], "}"}], 
                ",", "q", ",", RowBox[{"NormalizationParameters", "\[Rule]", 
                  RowBox[{"{", RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}], 
            "]"}], "[", "\"Parameters\"", "]"}], ",", "\"Label\""}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"\"a\"", ",", "\"b\""}], "}"}]], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ModularFormDefinition", "[", 
        RowBox[{RowBox[{"{", "q", "}"}], ",", "q", ",", 
          RowBox[{"NormalizationParameters", "\[Rule]", 
            RowBox[{"{", "_", "}"}]}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/NormalizationParameters", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "NormalizationParameters \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
