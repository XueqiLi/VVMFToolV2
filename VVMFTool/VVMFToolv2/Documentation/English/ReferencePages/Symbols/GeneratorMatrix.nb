Notebook[{Cell["GeneratorMatrix", "ObjectName"], 
  Cell["GeneratorMatrix[r, i] returns the matrix of the i-th recorded \
generator in the representation value r.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Returns the stored matrix of the \
i-th recorded generator, counting from 1, exactly as held in the value. \
Positions do not imply modular roles; use SRep and TRep with a group's \
explicit assignment.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["Rep", BaseStyle -> "Hyperlink", 
      ButtonData -> {"Rep.nb", None}], "  |  ", ButtonBox["RepMatrix", 
      BaseStyle -> "Hyperlink", ButtonData -> {"RepMatrix.nb", None}], 
     "  |  ", ButtonBox["SRep", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SRep.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"GeneratorMatrix", "[", 
      RowBox[{InterpretationBox[TemplateBox[{"\"Rep[\"", 
           TemplateBox[{", ", "\", \"", TagBox[RowBox[{"(", "\[NoBreak]", 
                GridBox[{{"0", "1"}, {"1", "0"}}, RowSpacings -> 1, 
                 ColumnSpacings -> 1, RowAlignments -> Baseline, 
                 ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
              Function[BoxForm`e$, MatrixForm[BoxForm`e$]]], 
             TagBox[RowBox[{"(", "\[NoBreak]", GridBox[{{"1", "0"}, 
                  {"0", RowBox[{"-", "1"}]}}, RowSpacings -> 1, 
                 ColumnSpacings -> 1, RowAlignments -> Baseline, 
                 ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
              Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}, 
            "RowWithSeparators"], "\"]\""}, "RowDefault"], 
         Rep[{{{0, 1}, {1, 0}}, {{1, 0}, {0, -1}}}]], ",", "2"}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"1", ",", "0"}], 
          "}"}], ",", RowBox[{"{", RowBox[{"0", ",", RowBox[{"-", "1"}]}], 
          "}"}]}], "}"}]], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"GeneratorMatrix", "[", 
        RowBox[{InterpretationBox[TemplateBox[{"\"Rep[\"", 
             TemplateBox[{", ", "\", \"", TagBox[RowBox[{"(", "\[NoBreak]", 
                  GridBox[{{"1"}}, RowSpacings -> 1, ColumnSpacings -> 1, 
                   RowAlignments -> Baseline, ColumnAlignments -> Center], 
                  "\[NoBreak]", ")"}], Function[BoxForm`e$, MatrixForm[
                  BoxForm`e$]]]}, "RowWithSeparators"], "\"]\""}, 
            "RowDefault"], Rep[{{{1}}}]], ",", "2"}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/GeneratorMatrix", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "GeneratorMatrix \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
