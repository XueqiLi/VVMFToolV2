Notebook[{Cell["Field", "ObjectName"], Cell["Field[data] is an immutable \
field transforming in one irrep: ID, name, irrep, accepted matrices (its \
transformation law), frozen context and inert components.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Field[data] is an immutable field \
that transforms in one irrep of a finite group: it stores its ID, display \
name, irrep ID, dimension, the accepted matrices of that irrep (its \
transformation law), the basis identity and the frozen RepresentationContext \
it was created in.", "Notes"], Cell["Its components are inert FieldComponent \
atoms; the name is a display label and never becomes a Wolfram variable. \
Later reordering or basis changes of the group do not rewrite a field: it \
keeps its frozen context.", "Notes"], Cell["Create fields with CreateField; a \
Field whose data was edited by hand is rejected by every operation.", 
   "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["CreateField", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CreateField.nb", None}], "  |  ", 
     ButtonBox["FieldComponents", BaseStyle -> "Hyperlink", 
      ButtonData -> {"FieldComponents.nb", None}], "  |  ", 
     ButtonBox["FieldVector", BaseStyle -> "Hyperlink", 
      ButtonData -> {"FieldVector.nb", None}], "  |  ", 
     ButtonBox["CreateModel", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CreateModel.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "sign", ",", "l", ",", "r", ",", "m"}], "}"}], 
        ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"sign", "=", RowBox[{"First", "[", RowBox[{"DeleteCases", 
                "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                        "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                         {RowBox[{"RepDim", "[", RowBox[
                          {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "1"}], "&"}]}], "]"}], 
                  ",", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", "]"}], 
                    "[", "\"TrivialIrrepID\"", "]"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"Head", "[", "l", "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["Field"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"FieldComponents", "[", 
        InterpretationBox[TemplateBox[{"\"Field[\"", "\"?\"", 
           "\", dimension \"", "\"?\"", "\"]\""}, "RowDefault"], 
         Field[Association[]]], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/Field", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "Field \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
