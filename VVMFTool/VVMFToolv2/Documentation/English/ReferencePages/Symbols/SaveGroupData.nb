Notebook[{Cell["SaveGroupData", "ObjectName"], Cell["SaveGroupData[group, \
file] atomically saves a mathematical JSON snapshot and registers its \
validated bytes in the independent local export ledger.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Atomically writes a versioned JSON \
mathematical snapshot, including computed optional data and a reference to \
retained GAP state. Returns the absolute filename. No GAP computation or \
object mutation occurs.", "Notes"], Cell["Registers the completed bytes in an \
independent local export ledger. GAP cache eviction leaves this ledger \
intact. Registration failure returns Failure with SavedFile, identifying the \
usable but unregistered mathematical file.", "Notes"], 
  Cell["The file contains inert values. A cache reference can outlive the \
workspace; it is not permission to load arbitrary binary state.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ImportGroupData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ImportGroupData.nb", None}], "  |  ", 
     ButtonBox["CleanGAPCache", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CleanGAPCache.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"CatalogueGroup", "[", RowBox[
                     {"\"CyclicGroup\"", ",", "3"}], "]"}], ",", 
                  RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], 
                  ",", RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], 
                "]"}]}], ",", RowBox[{"d", "=", RowBox[{"CreateDirectory", 
                "[", "]"}]}], ",", "p"}], "}"}], ",", 
        RowBox[{"WithCleanup", "[", RowBox[{"Null", ",", 
            RowBox[{RowBox[{"p", "=", RowBox[{"SaveGroupData", "[", 
                  RowBox[{"g", ",", RowBox[{"FileNameJoin", "[", RowBox[
                       {"{", RowBox[{"d", ",", "\"group.json\""}], "}"}], 
                      "]"}]}], "]"}]}], ";", RowBox[{"FileExistsQ", "[", "p", 
                "]"}]}], ",", RowBox[{"DeleteDirectory", "[", 
              RowBox[{"d", ",", RowBox[{"DeleteContents", "\[Rule]", 
                  "True"}]}], "]"}]}], "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"SaveGroupData", "[", 
        RowBox[{"3", ",", "\"invalid.json\""}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/SaveGroupData", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "SaveGroupData \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
