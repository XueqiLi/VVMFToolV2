Notebook[{Cell["CleanRepresentationCache", "ObjectName"], 
  Cell["CleanRepresentationCache[g] removes derived representation caches of \
g and advances their eviction epoch; representations and characters are \
kept.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["CleanRepresentationCache[g] removes derived representation data of g \
\[LongDash] element matrices, cached validation results (Unitarity), \
decompositions and derived intermediates such as invariant forms \[LongDash] \
and returns Removed (entries removed per kind), Protected and the new Epoch."\
, "Notes"], Cell["Active variants, accepted partials, derivation witnesses \
and characters are never removed. The eviction epoch advances atomically and \
is saved with SaveGroupData; later GAP work on an older retained workspace \
drops that workspace's derived data first. CleanGAPCache manages GAP \
workspace files.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["CacheKinds"], "TableText"], Cell["All", "TableText"], 
       Cell["\"ElementMatrices\", \"Unitarity\" (cached \
ValidateRepresentation results, also cleared when the modular assignment \
changes), \"Decompositions\" and \"DerivedIntermediates\" (invariant forms), \
or a list of them.", "TableText"]}}, GridBoxAlignment -> 
      {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["CacheKinds", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CacheKinds.nb", None}], "  |  ", 
     ButtonBox["RepresentationElementMatrices", BaseStyle -> "Hyperlink", 
      ButtonData -> {"RepresentationElementMatrices.nb", None}], "  |  ", 
     ButtonBox["CleanGAPCache", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CleanGAPCache.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "id"}], "}"}], ",", RowBox[
         {RowBox[{"id", "=", RowBox[{"Last", "[", RowBox[{"g", "[", 
                "\"IrrepOrder\"", "]"}], "]"}]}], ";", 
          RowBox[{"RepresentationElementMatrices", "[", 
            RowBox[{"g", ",", "id", ",", RowBox[{"{", RowBox[{"GroupWord", 
                  "[", "\"s\"", "]"}], "}"}]}], "]"}], ";", 
          RowBox[{RowBox[{"CleanRepresentationCache", "[", RowBox[{"g", ",", 
                RowBox[{"CacheKinds", "\[Rule]", "\"ElementMatrices\""}]}], 
              "]"}], "[", "\"Removed\"", "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"Association", "[", RowBox[{"\"ElementMatrices\"", 
        "\[Rule]", "1"}], "]"}]], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                   {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", ",", 
                        "\"(s.t)^3\""}], "}"}]}], "]"}], ",", RowBox[
                 {"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], "}"}], 
        ",", RowBox[{"FailureQ", "[", RowBox[{"CleanRepresentationCache", 
            "[", RowBox[{"g", ",", RowBox[{"CacheKinds", "\[Rule]", 
                "\"Other\""}]}], "]"}], "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/CleanRepresentationCache", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
