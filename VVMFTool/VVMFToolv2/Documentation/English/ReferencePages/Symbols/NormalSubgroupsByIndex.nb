  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"r", "=", RowBox[
             {"NormalSubgroupsByIndex", "[", RowBox[{RowBox[
                 {"GroupPresentation", "[", RowBox[{RowBox[{"{", "\"a\"", 
                      "}"}], ",", RowBox[{"{", "}"}]}], "]"}], ",", "3"}], 
              "]"}]}], "}"}], ",", RowBox[
         {"{", RowBox[{RowBox[{"r", "[", "\"Complete\"", "]"}], ",", 
            RowBox[{"Lookup", "[", RowBox[{RowBox[{"r", "[", "\"Items\"", 
                  "]"}], ",", "\"Index\""}], "]"}]}], "}"}]}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"True", ",", RowBox[{"{", "3", "}"}]}], 
      "}"}]], "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
