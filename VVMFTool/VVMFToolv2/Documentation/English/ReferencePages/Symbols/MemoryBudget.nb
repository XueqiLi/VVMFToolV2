Notebook[{Cell["MemoryBudget", "ObjectName"], Cell["MemoryBudget specifies \
the total worker memory budget in bytes, or Automatic.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Option for the group builders and \
every GAP-backed group operation (GroupElementWords, GroupWordOrder, \
AssignModularGenerators, GroupSubgroups, CheckGeneratorMap, RestoreGAPState, \
ImportGroupData) and NormalSubgroupsByIndex; also a ConfigureVVMFTool \
default. Default: Automatic.", "Notes"], Cell["Positive integer bytes, or \
Automatic using half system memory less current kernel usage. Admission \
estimates and sampled total worker RSS enforce the allocation.", "Notes"], 
  Cell["Per-call shared settings override matching package configuration. The \
owning function rejects unsupported values before computation.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BuildGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildGroup.nb", None}], "  |  ", 
     ButtonBox["ConfigureVVMFTool", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ConfigureVVMFTool.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", "BuildGroup", 
            "]"}]}], ",", "MemoryBudget"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/MemoryBudget", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "MemoryBudget \[LongDash] VVMFTool", 
