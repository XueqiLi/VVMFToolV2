Notebook[{Cell["RepVector", "ObjectName"], Cell["RepVector[data] is an \
immutable representation-valued vector: ordered records (target irrep, \
components, contraction path, basis identity, arithmetic) bound to the frozen \
RepresentationContext it was made in.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["RepVector[data] is an immutable \
representation-valued vector: ordered records (TargetID, Components, Path, \
ChannelIDs, BasisID, Arithmetic) bound to the frozen RepresentationContext it \
was made in. It stays usable with that context after the group's basis or \
order changes.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["MakeRepVector", BaseStyle -> "Hyperlink", 
      ButtonData -> {"MakeRepVector.nb", None}], "  |  ", 
     ButtonBox["VectorComponents", BaseStyle -> "Hyperlink", 
      ButtonData -> {"VectorComponents.nb", None}], "  |  ", 
     ButtonBox["TensorProductVectors", BaseStyle -> "Hyperlink", 
      ButtonData -> {"TensorProductVectors.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d"}], "}"}], ",", RowBox[
         {RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"Head", "[", RowBox[{"MakeRepVector", 
              "[", RowBox[{"g", ",", "d", ",", RowBox[{"{", RowBox[
                   {"x1", ",", "x2"}], "}"}]}], "]"}], "]"}]}]}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], Cell[BoxData["RepVector"], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"VectorComponents", "[", 
        InterpretationBox[TemplateBox[{"\"RepVector[\"", "0", 
           "\" records: \"", TagBox[RowBox[{"{", "}"}], Short[#1, 1] & ], 
           "\"]\""}, "RowDefault"], RepVector[Association[]]], "]"}], "]"}]], 
   "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/RepVector", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "RepVector \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
