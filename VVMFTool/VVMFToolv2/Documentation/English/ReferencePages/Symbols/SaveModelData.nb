Notebook[{Cell["SaveModelData", "ObjectName"], Cell["SaveModelData[m, file] \
atomically saves the Model m (fields, parameters, terms, frozen context and \
its group's mathematical snapshot) as a JSON archive and registers its bytes \
in the export ledger; MassMatrices -> <|name -> mass|> adds certified \
coefficient matrices.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["SaveModelData[m, file] saves the Model m as a versioned JSON archive: \
its fields, parameters (with their source spelling as text) and terms as \
typed expression trees, its frozen context, and the mathematical snapshot of \
its group (no retained GAP state, no CG data). It returns the absolute path."\
, "Notes"], Cell["Option MassMatrices -> <|name -> mass|> adds coefficient \
matrices, each certified against m; Overwrite (default False). The archive \
bytes are registered in the export ledger with the group's identities, so \
ImportModelData admits them without GAP.", "Notes"], 
  Cell["A model whose group is not loaded, or whose frozen context the \
group's current state cannot rebind (a changed modular assignment), fails \
before writing.", "Notes"], Cell["Stage 9: a modular model is saved with its \
formal slots, per-slot couplings and frozen bindings.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["MassMatrices"], "TableText"], Cell["<||>", "TableText"], 
       Cell["<||> (default) or an association from names to MassMatrix \
values. Other values fail with InvalidOption.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["Overwrite"], "TableText"], 
       Cell["False", "TableText"], 
       Cell["False refuses an existing file; True replaces it atomically.", 
        "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     GridBoxItemSize -> {"Columns" -> {Scaled[0.02], Scaled[0.3], 
         Scaled[0.18], Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ImportModelData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ImportModelData.nb", None}], "  |  ", 
     ButtonBox["MassMatrices", BaseStyle -> "Hyperlink", 
      ButtonData -> {"MassMatrices.nb", None}], "  |  ", 
     ButtonBox["SaveGroupData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SaveGroupData.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "l", ",", "r", ",", "m", ",", "mass"}], "}"}], 
        ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"AddModelTerm", "[", RowBox[{"m", ",", 
                RowBox[{"CoupleContractions", "[", RowBox[{"Contractions", 
                    "[", RowBox[{"m", ",", RowBox[{"{", RowBox[{"l", ",", 
                          "r"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";", 
          RowBox[{"mass", "=", RowBox[{"ExtractBilinearMatrix", "[", 
              RowBox[{RowBox[{"ModelExpression", "[", "m", "]"}], ",", "l", 
                ",", "r"}], "]"}]}], ";", RowBox[{"StringQ", "[", 
            RowBox[{"SaveModelData", "[", RowBox[{"m", ",", RowBox[
                 {"FileNameJoin", "[", RowBox[{"{", RowBox[
                     {"$TemporaryDirectory", ",", RowBox[{RowBox[
                         {"CreateUUID", "[", "]"}], "<>", "\".json\""}]}], 
                    "}"}], "]"}], ",", RowBox[{"MassMatrices", "\[Rule]", 
                  RowBox[{"Association", "[", RowBox[{"\"M\"", "\[Rule]", 
                      "mass"}], "]"}]}]}], "]"}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"SaveModelData", "[", 
        RowBox[{"\"m\"", ",", "\"x.json\""}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/SaveModelData", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "SaveModelData \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
