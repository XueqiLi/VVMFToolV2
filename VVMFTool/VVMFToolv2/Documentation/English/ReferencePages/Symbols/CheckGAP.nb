Notebook[{Cell["CheckGAP", "ObjectName"], Cell["CheckGAP[] probes the \
configured GAP executable and reports versions, packages, command flags and \
workspace support.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Starts a bounded discovery probe, including workspace save and \
fresh-process restoration. Reports executable/build/package capabilities; \
optional missing packages restrict their methods rather than preventing \
loading.", "Notes"], Cell["Requires a working local GAP with workspace \
support; JSON and IO are transport dependencies. Package loading alone does \
not run this probe. Operational failures return Failure.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ConfigureVVMFTool", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ConfigureVVMFTool.nb", None}], "  |  ", 
     ButtonBox["RestoreGAPState", BaseStyle -> "Hyperlink", 
      ButtonData -> {"RestoreGAPState.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"AssociationQ", "[", RowBox[{"CheckGAP", "[", "]"}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["True"], "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"CheckGAP", "[", "1", "]"}], 
      "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/CheckGAP", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "CheckGAP \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
