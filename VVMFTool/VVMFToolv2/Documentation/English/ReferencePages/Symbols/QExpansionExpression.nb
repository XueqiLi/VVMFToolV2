Notebook[{Cell["QExpansionExpression", "ObjectName"], 
  Cell["QExpansionExpression[qexp, z] gives the components of QExpansionData \
qexp as finite sums in z with their O[z]^cutoff remainders.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["QExpansionExpression[qexp, z] gives \
the components of QExpansionData as finite sums in z with their remainders \
O[z]^cutoff; rational and negative exponents are kept and the remainder is \
never erased.", "Notes"], Cell["z must be a symbol without a value.", 
   "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["QExpansionCoefficients", 
      BaseStyle -> "Hyperlink", ButtonData -> {"QExpansionCoefficients.nb", 
        None}], "  |  ", ButtonBox["ScalarQSeries", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ScalarQSeries.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"QExpansionExpression", "[", 
      RowBox[{RowBox[{"ScalarQSeries", "[", RowBox[
           {RowBox[{"ScalarModularExpression", "[", RowBox[{"\"E4\"", ",", 
                "q"}], "]"}], ",", "q", ",", "3"}], "]"}], ",", "z"}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"1", "+", RowBox[{"240", " ", "z"}], "+", 
        RowBox[{"2160", " ", SuperscriptBox["z", "2"]}], "+", 
        SuperscriptBox[RowBox[{"O", "[", "z", "]"}], "3"]}], "}"}]], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"QExpansionExpression", "[", 
        RowBox[{RowBox[{"ScalarQSeries", "[", RowBox[
             {RowBox[{"ScalarModularExpression", "[", RowBox[{"\"E4\"", ",", 
                  "q"}], "]"}], ",", "q", ",", "3"}], "]"}], ",", "3"}], 
        "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
