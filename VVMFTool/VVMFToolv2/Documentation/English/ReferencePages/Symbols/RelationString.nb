Notebook[{Cell["RelationString", "ObjectName"], 
  Cell["RelationString[\"[S^4,(S*T)^3,...]\"] gives the GroupPresentation of \
a relation string in the v1 / GAP form; BuildGroup and BuildModularGroup \
accept such a string directly.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["RelationString[text] gives the GroupPresentation of a relation string \
in the v1 / GAP form, for example \"[S^4,(S*T)^3,S^-2*T^-1*S^2*T,T^3]\": \
relators separated by commas, optionally in brackets, with * or . products, \
^n powers and parentheses; a relator a=b means a.b^-1.", "Notes"], 
  Cell["Generator order: the names given as a second argument; otherwise {S, \
T} when the identifiers are S and T; otherwise the order of first appearance. \
BuildGroup and BuildModularGroup accept such a string directly.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BuildGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildGroup.nb", None}], "  |  ", 
     ButtonBox["BuildModularGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildModularGroup.nb", None}], "  |  ", 
     ButtonBox["GroupPresentation", BaseStyle -> "Hyperlink", 
      ButtonData -> {"GroupPresentation.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"First", "[", RowBox[{"RelationString", "[", 
        "\"[T^7,S^3,T^-4*S*T*S^-1]\"", "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"\"S\"", ",", "\"T\""}], "}"}]], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"RelationString", "[", 
        "\"[S^4,,T]\"", "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/RelationString", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "RelationString \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
