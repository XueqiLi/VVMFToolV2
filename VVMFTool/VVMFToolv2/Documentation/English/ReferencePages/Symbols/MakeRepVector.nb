Notebook[{Cell["MakeRepVector", "ObjectName"], Cell["MakeRepVector[g, id] \
makes a vector of the irrep id with inert components; MakeRepVector[g, id, \
{c1, ..., cd}] uses explicit components (numbers or expressions).", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["MakeRepVector[g, id] makes a vector \
of the irrep id with inert components (ComponentLabel gives their display \
label); MakeRepVector[g, id, {c1, ..., cd}] uses explicit components (numbers \
or expressions, already evaluated); MakeRepVector[g, id, a] with a symbol a \
uses the components a[1], ..., a[d]. The irrep needs stored matrices.", 
   "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ComponentLabel"], "TableText"], 
       Cell["\"x\"", "TableText"], Cell["A nonempty string; default \"x\".", 
        "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     GridBoxItemSize -> {"Columns" -> {Scaled[0.02], Scaled[0.3], 
         Scaled[0.18], Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["VectorComponents", BaseStyle -> "Hyperlink", 
      ButtonData -> {"VectorComponents.nb", None}], "  |  ", 
     ButtonBox["TensorProductVectors", BaseStyle -> "Hyperlink", 
      ButtonData -> {"TensorProductVectors.nb", None}], "  |  ", 
     ButtonBox["CGPolynomialResult", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CGPolynomialResult.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d"}], "}"}], ",", RowBox[
         {RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{RowBox[{"VectorComponents", "[", 
              RowBox[{"MakeRepVector", "[", RowBox[{"g", ",", "d", ",", 
                  RowBox[{"{", RowBox[{"x1", ",", "x2"}], "}"}]}], "]"}], 
              "]"}], "\[LeftDoubleBracket]", RowBox[{"1", ",", 
              "\"Components\""}], "\[RightDoubleBracket]"}]}]}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"x1", ",", "x2"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"MakeRepVector", "[", 
        RowBox[{"\"no group\"", ",", "\"x\""}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/MakeRepVector", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "MakeRepVector \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
