Notebook[{Cell["TauPoint", "ObjectName"], 
  Cell["TauPoint[tau] is a point of the upper half plane (Im tau > 0).", 
   "Usage"], Cell["Status: Alpha.", "Notes"], Cell["TauPoint[tau] is a point \
of the upper half plane, Im tau > 0; fractional powers of q are evaluated as \
Exp[2 Pi I tau r] on the cusp branch.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["QPoint", BaseStyle -> "Hyperlink", 
      ButtonData -> {"QPoint.nb", None}], "  |  ", 
     ButtonBox["EvaluateScalarModular", BaseStyle -> "Hyperlink", 
      ButtonData -> {"EvaluateScalarModular.nb", None}], "  |  ", 
     ButtonBox["ModularFormEvaluate", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormEvaluate.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{RowBox[{"EvaluateScalarModular", "[", 
        RowBox[{RowBox[{"ScalarModularExpression", "[", 
            RowBox[{"\"E4\"", ",", "q"}], "]"}], ",", "q", ",", 
          InterpretationBox[TemplateBox[{"\"TauPoint[\"", "\[ImaginaryI]", 
             "\"]\""}, "RowDefault"], TauPoint[I]], ",", 
          RowBox[{"WorkingPrecision", "\[Rule]", "20"}]}], "]"}], "[", 
      "\"Branch\"", "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["\"Tau\""], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"EvaluateScalarModular", "[", 
        RowBox[{RowBox[{"ScalarModularExpression", "[", 
            RowBox[{"\"E4\"", ",", "q"}], "]"}], ",", "q", ",", 
          InterpretationBox[TemplateBox[{"\"TauPoint[\"", 
             RowBox[{"-", "\[ImaginaryI]"}], "\"]\""}, "RowDefault"], 
           TauPoint[-I]]}], "]"}], "]"}]], "Input", 
