Notebook[{Cell["ConstructionDependencies", "ObjectName"], 
  Cell["ConstructionDependencies lists existing absolute input file paths for \
a GAP-code construction.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for BuildGroupFromGAP. Default: {}.", "Notes"], 
  Cell["Existing absolute file paths read by explicit construction code. \
Their hashes are recorded, without copying external files. Keep them \
unchanged throughout the build; changed or missing inputs are rejected before \
execution, after construction and before publication. Later edits do not \
invalidate accepted mathematics.", "Notes"], Cell["Per-call shared settings \
override matching package configuration. The owning function rejects \
unsupported values before computation.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BuildGroupFromGAP", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildGroupFromGAP.nb", None}], "  |  ", 
     ButtonBox["ConfigureVVMFTool", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ConfigureVVMFTool.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", 
            "BuildGroupFromGAP", "]"}]}], ",", "ConstructionDependencies"}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ConstructionDependencies", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "ConstructionDependencies \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
