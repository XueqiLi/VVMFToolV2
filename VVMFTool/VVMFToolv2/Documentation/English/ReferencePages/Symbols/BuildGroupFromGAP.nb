Notebook[{Cell["BuildGroupFromGAP", "ObjectName"], 
  Cell["BuildGroupFromGAP[code, opts] executes explicit GAP construction code \
defining VVMFInputGroup and VVMFInputGenerators, and builds the resulting \
finite group.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Executes explicitly supplied GAP code. It must assign VVMFInputGroup \
and VVMFInputGenerators, the ordered list that generates the whole finite \
group. GeneratorNames is required and gives corresponding names.", "Notes"], 
  Cell["ConstructionDependencies lists absolute existing input files; their \
digests are recorded. Code and declared dependencies are retained as \
provenance, without promising undeclared reads are reproducible.", "Notes"], 
  Cell["Imported source is never replayed implicitly. If retained raw state \
is unavailable, explicitly rebuild the recipe. StoreGAPState->False still \
permits temporary checkpoints within this build.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["GroupModel"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic, \"Original\", \"Permutation\" or \
\"PC\" for new method calculations; PC requires a solvable group. Restoration \
and compatible cache hits do not convert models. Import uses it only when \
computing a new character-validation source.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["WordRecovery"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic or a duplicate-free \
list of \"Native\", \"FP\", \"Cayley\".", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["UnitarizationMethod"], 
        "TableText"], Cell["Automatic", "TableText"], Cell["\"GroupAverage\" \
averages M^\[Dagger].M over the image of the group; \"GeneratorEquations\" \
solves M^\[Dagger].H.M == H on the generators and chooses a positive \
solution; \"BSGSAverage\" is a native GAP route (automatic representation \
computation and TransformGroupRepresentations in GAP) and is refused where \
the work runs in Wolfram.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["WitnessVariant"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic, \"SmallestConductor\" or \"Active\".", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ComputeRepresentations"], "TableText"], 
       Cell["True", "TableText"], Cell["True computes every irreducible \
representation after the mandatory group data, as ComputeGroupRepresentations \
does, using the builder's Basis, RepresentationMethod and MethodData. Set \
False for character-only work; the representation options are then refused.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ComputeElements"], "TableText"], 
       Cell["False", "TableText"], Cell["True computes all recorded-generator \
element words during construction.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["ComputeSubgroups"], 
        "TableText"], Cell["False", "TableText"], 
       Cell[
        "True computes the selected subgroup collection during construction."\
, "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["SubgroupDescriptions"], "TableText"], 
       Cell["False", "TableText"], Cell["True requests actual subgroup \
structure descriptions; in builders it implies ComputeSubgroups.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["CharacterMethod"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic, \"DixonSchneider\", \
\"Unger\", \"Conlon\", \"BaumClausen\", \"KnownTable\" or \"GAP\". \
Eligibility depends on the group and installed packages; explicit partial \
methods can return resumable exhaustion.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["Name"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic or a display-name \
string. Does not identify mathematical equivalence.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["SubgroupKind"], "TableText"], 
       Cell["\"ConjugacyClasses\"", "TableText"], Cell["\"ConjugacyClasses\", \
\"All\" or \"Normal\". Class representatives and individual embeddings are \
distinct result kinds.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Basis"], "TableText"], Cell["\"Unitary\"", "TableText"], 
       Cell["\"Unitary\" requires unitary matrices on every recorded \
generator; \"General\" accepts any verified basis. \"UnitaryTDiagonal\" \
(ComputeGroupRepresentations, the builders and TransformGroupRepresentations) \
additionally requires the assigned T to be diagonal, with its phases in the \
TPhaseOrder order and the PhaseConvention applied (the group needs a modular \
S,T assignment). SetGroupRepresentation and ChangeGroupRepBasis accept \
\"Unitary\" and \"General\"; TransformGroupRepresentations \"Unitary\" and \
\"UnitaryTDiagonal\". For DiagonalizeRepresentationT, \"Unitary\" requires \
unitary input and keeps the result unitary.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["RepresentationMethod"], 
        "TableText"], Cell["Automatic", "TableText"], 
       Cell["Automatic, \"SL2Reps\", \"LinearCharacter\", \"DixonUnitary\", \
\"BaumClausen\", \"InducedUnitary\", \"Dixon\", \"REPSN\", \
\"CharacterSubgroup\", \"Induction\", \"Extension\", \"NormalExtension\", \
\"AtlasRep\" or \"GAP\". Automatic runs direct unitary routes before general \
ones; every result is verified on the actual group.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["MethodData"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["<|\"SubgroupGenerators\" -> \
{GroupWord..}, \"Representation\" -> Rep|> for CharacterSubgroup, Induction, \
InducedUnitary, Extension and NormalExtension (the Representation is optional \
and not used by CharacterSubgroup); <|\"AtlasName\" -> name, \
\"RepresentationNumber\" -> n|> for AtlasRep.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["TPhaseOrder"], "TableText"], 
       Cell["\"Ascending\"", "TableText"], Cell["\"Ascending\" orders the \
diagonal T by phase in [0,1) (nondecreasing); \"Unchanged\" orders basis \
vectors by their first nonzero coordinate, so an already diagonal T keeps its \
basis. Vectors of one eigenvalue keep their order. With \
ComputeGroupRepresentations, an irrep whose diagonal T is in another order \
(for example from SL2Reps) is diagonalized again in GAP.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["PhaseConvention"], 
        "TableText"], Cell["None", "TableText"], Cell["\"FirstSRow\" applies \
a diagonal unitary rephasing after diagonalization: the first basis phase is \
one, and each nonzero first-row entry of S after the first becomes real and \
nonnegative; zero entries keep their phase and S11 is unchanged.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Verification"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic, \"Exact\", \"Numerical\" or None (the \
Validate functions: Automatic, \"Exact\" or \"Numerical\"; the modular-form \
functions have no \"Exact\" route).", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["StoreGAPState"], 
        "TableText"], Cell["True", "TableText"], Cell["True retains verified \
state across calls; False keeps only call-local temporary checkpoints. Cached \
mathematical values remain available.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["AttemptTimeLimit"], 
        "TableText"], Cell["600", "TableText"], Cell["Positive seconds or \
Infinity, per attempt including verification and saving. Automatic method \
attempts each receive this limit.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["CoreBudget"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Positive integer at most \
$ProcessorCount, or Automatic to use the available count. Sequential \
algorithms run as separate worker processes.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["MemoryBudget"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Positive integer bytes, or \
Automatic using half system memory less current kernel usage. Admission \
estimates and sampled total worker RSS enforce the allocation.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ProgressFunction"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic shows a notebook \
monitor when a front end is available; None is silent; a Function or user \
symbol receives progress associations. Callbacks should return promptly; \
failures/cancellation clean owned workers.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["GeneratorNames"], 
        "TableText"], Cell["Automatic", "TableText"], Cell["Ordered distinct \
identifier strings matching VVMFInputGenerators. An explicit list is required \
for BuildGroupFromGAP; an empty list describes no generators.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ConstructionDependencies"], "TableText"], 
       Cell["{}", "TableText"], Cell["Existing absolute file paths read by \
explicit construction code. Their hashes are recorded, without copying \
external files. Keep them unchanged throughout the build; changed or missing \
inputs are rejected before execution, after construction and before \
publication. Later edits do not invalidate accepted mathematics.", 
        "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     GridBoxItemSize -> {"Columns" -> {Scaled[0.02], Scaled[0.3], 
         Scaled[0.18], Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BuildGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildGroup.nb", None}], "  |  ", 
     ButtonBox["ImportGroupData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ImportGroupData.nb", None}], "  |  ", 
     ButtonBox["ConstructionDependencies", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ConstructionDependencies.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroupFromGAP", 
              "[", RowBox[{"\"VVMFInputGroup := CyclicGroup(3);; \
VVMFInputGenerators := GeneratorsOfGroup(VVMFInputGroup);;\"", ",", 
                RowBox[{"GeneratorNames", "\[Rule]", RowBox[{"{", "\"a\"", 
                    "}"}]}], ",", RowBox[{"ComputeRepresentations", 
                  "\[Rule]", "False"}], ",", RowBox[{"StoreGAPState", 
                  "\[Rule]", "False"}]}], "]"}]}], "}"}], ",", 
        RowBox[{"g", "[", "\"Order\"", "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["3"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"BuildGroupFromGAP", "[", 
        RowBox[{"\"\"", ",", RowBox[{"GeneratorNames", "\[Rule]", 
            RowBox[{"{", "\"a\"", "}"}]}], ",", 
          RowBox[{"ComputeRepresentations", "\[Rule]", "False"}]}], "]"}], 
      "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/BuildGroupFromGAP", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "BuildGroupFromGAP \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
