Notebook[{Cell["MaxBytes", "ObjectName"], 
  Cell["MaxBytes sets the retained GAP cache byte cap; the default is 10^9.", 
   "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for CleanGAPCache. Default: 10^9.", "Notes"], 
  Cell["Nonnegative integer bytes for least-recently-used cleanup. Zero \
removes every eligible entry.", "Notes"], Cell["Per-call shared settings \
override matching package configuration. The owning function rejects \
unsupported values before computation.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
