Notebook[{Cell["ModularFormGetCoeff", "ObjectName"], 
  Cell["ModularFormGetCoeff[y] resolves the relative-normalization \
coefficients of the modular form y and commits them atomically; it returns \
y.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["ModularFormGetCoeff[y] resolves the relative-normalization \
coefficients of y with SolveModularCoefficients' method and commits them \
atomically (aliases see it); it returns y, and a Failure leaves y unchanged."\
, "Notes"], Cell["A coupled G is solved through its frozen companion F \
recipe; a derivative through its source recipe and anchor. A coefficient-free \
form is a no-op. Options as SolveModularCoefficients.", "Notes"], 
  Cell["An explicit Method -> \"Reconstruct\" fails with \
ReconstructionRejected when no exact candidate passes the checks (the \
numerical fit is attached under \"NumericalFit\"); Method -> Automatic \
returns the numerical fit in that case.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Method"], "TableText"], Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["WorkingPrecision"], 
        "TableText"], Cell["80", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["AccuracyGoal"], "TableText"], 
       Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["SeriesOrder"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic (default: chosen from \
the accuracy goal and the point, or 6 orders for construction checks) or a \
positive integer; an explicit order is required to evaluate a finite jet (the \
result then has EstimatedError Missing[\"NoTailBound\"] or the next-order \
difference).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["NormalizationRules"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic (default: fit) or \
rules (or an association) from every parameter ID to a value; incomplete \
rules fail with InvalidOption and wrong values with \
InconsistentNormalization; checked exact rules report ProofStatus \
\"NumericallyCheckedExplicitRules\" (inexact ones \
\"NumericalExplicitRules\").", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["RequireProof"], "TableText"], 
       Cell["False", "TableText"], Cell["False (default) or True: a result \
that is not Proven (numerical fits, verified reconstructions, sampled checks) \
fails with ProofRequired.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Normalization"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic (default) resolves from the \
participating matrices; \"Unitary\" or \"Dual\" fix the convention.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], Cell[BoxData["TimeLimit"], 
        "TableText"], Cell["600", "TableText"], Cell["600 (default), a \
positive number or Infinity; exceeding it fails with TimeLimit and changes \
nothing.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Verification"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic, \"Exact\", \"Numerical\" or None (the \
Validate functions: Automatic, \"Exact\" or \"Numerical\"; the modular-form \
functions have no \"Exact\" route).", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["SolveModularCoefficients", 
      BaseStyle -> "Hyperlink", ButtonData -> {"SolveModularCoefficients.nb", 
        None}], "  |  ", ButtonBox["ConstructModularForms", 
      BaseStyle -> "Hyperlink", ButtonData -> {"ConstructModularForms.nb", 
        None}]}], "SeeAlso"], Cell["Examples Initialization", 
   "ExamplesInitializationSection"], Cell["Open this notebook in its \
repository location. GAP must be installed; LINS is required for its bounded \
search page. Evaluate the setup before the examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "one"}], "}"}], ",", 
        RowBox[{RowBox[{"AssignModularGenerators", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"one", "=", RowBox[
             {RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
              "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"y", "=", 
                  RowBox[{"First", "[", RowBox[{"ConstructModularForms", "[", 
                      RowBox[{"g", ",", "d"}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{RowBox[{"ModularFormGetCoeff", "[", RowBox[{"y", ",", 
                    RowBox[{"WorkingPrecision", "\[Rule]", "30"}]}], "]"}], 
                ";", RowBox[{"Values", "[", RowBox[{RowBox[{"y", "[", 
                      "\"Coefficients\"", "]"}], "[", "\"Rules\"", "]"}], 
                  "]"}]}]}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"-", "24"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ModularFormGetCoeff", "[", 
        "5", "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
