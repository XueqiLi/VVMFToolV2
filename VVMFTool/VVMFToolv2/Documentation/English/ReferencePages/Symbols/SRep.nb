Notebook[{Cell["SRep", "ObjectName"], Cell["SRep[g, r] returns the matrix of \
the modular generator S assigned to group or context g, evaluated as its \
assigned word on the matrices of r.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Evaluates the group's assigned S \
word on the representation's matrices, which must be one per recorded \
generator in recorded order. There is no positional fallback: a group without \
an assignment gives MissingModularAssignment.", "Notes"], 
  Cell["The first argument is a live Group or a RepresentationContext bound \
in this kernel; an unbound or altered context gives UnverifiedContext. SRep \
does not certify that the matrices represent the group.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["TRep", BaseStyle -> "Hyperlink", 
      ButtonData -> {"TRep.nb", None}], "  |  ", 
     ButtonBox["AssignModularGenerators", BaseStyle -> "Hyperlink", 
      ButtonData -> {"AssignModularGenerators.nb", None}], "  |  ", 
     ButtonBox["RepresentationContext", BaseStyle -> "Hyperlink", 
      ButtonData -> {"RepresentationContext.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{
                "BuildModularGroup", "[", RowBox[{"\"24-3I\"", ",", 
                  RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], 
                  ",", RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], 
                "]"}]}], ",", "r"}], "}"}], ",", 
        RowBox[{RowBox[{"r", "=", InterpretationBox[TemplateBox[
              {"\"Rep[\"", "1", "\" parts]\""}, "RowDefault"], 
             Rep[Replace[Lookup[g["Generators"], "Name"], {"S" -> {{1}}, 
                "T" -> {{Root[#1^2 + #1 + 1 & , 2]}}}, {1}]]]}], ";", 
          RowBox[{"SRep", "[", RowBox[{"g", ",", "r"}], "]"}]}]}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"CatalogueGroup", "[", RowBox[
                   {"\"CyclicGroup\"", ",", "3"}], "]"}], ",", 
                RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"FailureQ", "[", RowBox[{"SRep", "[", 
            RowBox[{"g", ",", InterpretationBox[TemplateBox[{"\"Rep[\"", 
                 TemplateBox[{", ", "\", \"", TagBox[RowBox[{"(", 
                      "\[NoBreak]", GridBox[{{"1"}}, RowSpacings -> 1, 
                       ColumnSpacings -> 1, RowAlignments -> Baseline, 
                       ColumnAlignments -> Center], "\[NoBreak]", ")"}], 
                    Function[BoxForm`e$, MatrixForm[BoxForm`e$]]]}, 
                  "RowWithSeparators"], "\"]\""}, "RowDefault"], Rep[
                {{{1}}}]]}], "]"}], "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/SRep", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "SRep \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
