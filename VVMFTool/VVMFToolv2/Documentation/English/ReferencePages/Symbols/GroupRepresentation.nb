Notebook[{Cell["GroupRepresentation", "ObjectName"], 
  Cell["GroupRepresentation[g, id] returns the active Rep of the irrep with \
ID id, or Missing[\"NotComputed\"]; it never starts a computation.", 
   "Usage"], Cell["Status: Alpha.", "Notes"], Cell["Returns the Rep of the \
irrep's active variant, the basis that satisfied the request, or \
Missing[\"NotComputed\"]. Reading never starts a computation. Unknown irrep \
IDs give a Failure.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ComputeGroupRepresentations", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"ComputeGroupRepresentations.nb", None}], "  |  ", 
     ButtonBox["RepresentationData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"RepresentationData.nb", None}], "  |  ", 
     ButtonBox["Rep", BaseStyle -> "Hyperlink", ButtonData -> 
       {"Rep.nb", None}]}], "SeeAlso"], Cell["Examples Initialization", 
   "ExamplesInitializationSection"], Cell["Open this notebook in its \
repository location. GAP must be installed; LINS is required for its bounded \
search page. Evaluate the setup before the examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"CatalogueGroup", "[", RowBox[
                   {"\"SymmetricGroup\"", ",", "3"}], "]"}], ",", 
                RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"GroupRepresentation", "[", 
          RowBox[{"g", ",", RowBox[{"First", "[", RowBox[{"g", "[", 
                "\"IrrepOrder\"", "]"}], "]"}]}], "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"Missing", "[", "\"NotComputed\"", "]"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"CatalogueGroup", "[", RowBox[
                   {"\"SymmetricGroup\"", ",", "3"}], "]"}], ",", 
                RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"FailureQ", "[", RowBox[{"GroupRepresentation", 
            "[", RowBox[{"g", ",", "\"unknown-irrep\""}], "]"}], "]"}]}], 
      "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
