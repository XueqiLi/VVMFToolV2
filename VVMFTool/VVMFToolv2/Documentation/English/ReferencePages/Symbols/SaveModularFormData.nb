Notebook[{Cell["SaveModularFormData", "ObjectName"], 
  Cell["SaveModularFormData[<|name -> y, ...|>, file] or \
SaveModularFormData[y, file] saves modular forms (records, definitions, \
coefficients, stored expansions, evidence) and their group as a validated \
JSON archive.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["SaveModularFormData[<|name -> y, ...|>, file] or \
SaveModularFormData[y, file] saves modular forms with their group as a \
versioned JSON archive (records, definitions, coefficients and anchor frames, \
stored expansions, evidence) and returns the path.", "Notes"], 
  Cell["Forms of one group state per archive; an existing file needs \
Overwrite -> True; no code or GAP state is saved and nothing is computed.", 
   "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Overwrite"], "TableText"], Cell["False", "TableText"], 
       Cell["False refuses an existing file; True replaces it atomically.", 
        "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     GridBoxItemSize -> {"Columns" -> {Scaled[0.02], Scaled[0.3], 
         Scaled[0.18], Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ImportModularFormData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ImportModularFormData.nb", None}], "  |  ", 
     ButtonBox["SaveModelData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SaveModelData.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "one", ",", "y"}], "}"}], ",", 
        RowBox[{RowBox[{"AssignModularGenerators", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"one", "=", RowBox[
             {RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
              "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"y", "=", RowBox[{"First", "[", RowBox[{
                "ConstructModularForms", "[", RowBox[{"g", ",", "d"}], "]"}], 
              "]"}]}], ";", RowBox[{"ModularFormGetCoeff", "[", 
            RowBox[{"y", ",", RowBox[{"WorkingPrecision", "\[Rule]", 
                "30"}]}], "]"}], ";", RowBox[{"FileExistsQ", "[", 
            RowBox[{"SaveModularFormData", "[", RowBox[{"y", ",", 
                RowBox[{"FileNameJoin", "[", RowBox[{"{", RowBox[
                     {"$TemporaryDirectory", ",", RowBox[
                       {"\"vvmf-doc-forms-\"", "<>", RowBox[{"CreateUUID", 
                          "[", "]"}], "<>", "\".json\""}]}], "}"}], "]"}]}], 
              "]"}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"SaveModularFormData", "[", 
        RowBox[{RowBox[{"Association", "[", "]"}], ",", "\"x.json\""}], 
        "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/SaveModularFormData", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "SaveModularFormData \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
