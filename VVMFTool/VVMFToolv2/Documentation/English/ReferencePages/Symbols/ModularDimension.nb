Notebook[{Cell["ModularDimension", "ObjectName"], 
  Cell["ModularDimension[c, irrep, k] gives the dimension of the space of \
weight-k vector-valued modular forms of the irrep, or \
Missing[\"UnknownDimension\", reason].", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["ModularDimension[c, irrep, k] gives \
the dimension of the weight-k vector-valued modular forms of the irrep: from \
the weight profile (ranks 1-5, Hilbert series) cross-checked with the k >= 2 \
trace formula, or the trace formula alone beyond profile coverage; \
Missing[\"UnknownDimension\", reason] where neither applies (weight one above \
rank 5).", "Notes"], Cell["Negative weights and weights with rho(S^2) != e^{i \
Pi k} give 0 (for integer k this is the parity rho(S^2) = (-1)^k; every \
non-integer k gives 0 for an SL(2,Z) quotient, since rho(S^2) = +-1); k is an \
exact rational; weight zero gives 1 for the trivial irrep only. Exponents are \
certified exact T phases; numerical matrices fail with MissingExactSpectrum. \
Options Method and DimensionCache.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Method"], "TableText"], Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["DimensionCache"], 
        "TableText"], Cell["True", "TableText"], 
       Cell["True (default) or False.", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularDimensionData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularDimensionData.nb", None}], "  |  ", 
     ButtonBox["ModularWeightProfile", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularWeightProfile.nb", None}], "  |  ", 
     ButtonBox["ModularFormExistQ", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormExistQ.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "one"}], "}"}], ",", 
        RowBox[{RowBox[{"AssignModularGenerators", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"one", "=", RowBox[
             {RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
              "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"ModularDimension", "[", RowBox[{"g", ",", "d", ",", "8"}], 
            "]"}]}]}], "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["2"], "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ModularDimension", "[", 
        RowBox[{"\"g\"", ",", "\"x\"", ",", "2"}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ModularDimension", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
