Notebook[{Cell["ScalarNotation", "ObjectName"], 
  Cell["ScalarNotation selects how certified roots of unity are written: \
\"Standard\", \"Exponential\" or \"Omega\".", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Option for the view producers, the \
renderers, ScalarLaTeX and MatrixLaTeX. Default: \"Standard\".", "Notes"], 
  Cell["\"Standard\" writes a certified root of unity as exact radicals a + b \
i when possible; \"Exponential\" as e^{2 pi i k/n}; \"Omega\" as omega_n^k \
(with its definition once when DefineOmega is True). Only exactly certified \
rational phases are converted; other values are unaffected. In \"Standard\" a \
table can therefore mix forms (fifth roots of unity have radical forms, 25th \
roots are written exponentially); \"Exponential\" and \"Omega\" give a \
uniform table.", "Notes"], 
  Cell[
   "The owning function rejects other values before rendering or \
computation.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ScalarLaTeX", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ScalarLaTeX.nb", None}], "  |  ", 
     ButtonBox["DefineOmega", BaseStyle -> "Hyperlink", 
      ButtonData -> {"DefineOmega.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", "ScalarLaTeX", 
            "]"}]}], ",", "ScalarNotation"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ScalarNotation", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "ScalarNotation \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
