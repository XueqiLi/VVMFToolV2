Notebook[{Cell["QuadraticConvention", "ObjectName"], 
  Cell["QuadraticConvention chooses the quadratic matrix convention: \
\"Polynomial\" (selected == x . M . x) or \"Half\" (selected == (x . M . \
x)/2).", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for ExtractQuadraticMatrix: the normalization of the symmetric \
quadratic matrix.", "Notes"], Cell["\"Polynomial\" (default, selected == x . \
M . x) or \"Half\" (selected == (x . M . x)/2, the Hessian matrix).", 
   "Notes"], Cell["Other values fail with InvalidOption.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ExtractQuadraticMatrix", 
      BaseStyle -> "Hyperlink", ButtonData -> {"ExtractQuadraticMatrix.nb", 
        None}]}], "SeeAlso"], Cell["Examples Initialization", 
   "ExamplesInitializationSection"], Cell["Open this notebook in its \
repository location. GAP must be installed; LINS is required for its bounded \
search page. Evaluate the setup before the examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MatrixValues", "[", 
      RowBox[{"ExtractQuadraticMatrix", "[", 
        RowBox[{RowBox[{RowBox[{"a", " ", SuperscriptBox["p", "2"]}], "+", 
            RowBox[{"b", " ", "p", " ", "q"}], "+", 
            RowBox[{"c", " ", SuperscriptBox["q", "2"]}]}], ",", 
          RowBox[{"{", RowBox[{"p", ",", "q"}], "}"}], ",", 
          RowBox[{"QuadraticConvention", "\[Rule]", "\"Half\""}]}], "]"}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"2", " ", "a"}], ",", "b"}], 
          "}"}], ",", RowBox[{"{", RowBox[{"b", ",", 
            RowBox[{"2", " ", "c"}]}], "}"}]}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ExtractQuadraticMatrix", 
        "[", RowBox[{SuperscriptBox["p", "2"], ",", RowBox[{"{", "p", "}"}], 
          ",", RowBox[{"QuadraticConvention", "\[Rule]", "\"Other\""}]}], 
        "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/QuadraticConvention", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "QuadraticConvention \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
