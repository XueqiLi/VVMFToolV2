Notebook[{Cell["FieldComponent", "ObjectName"], 
  Cell["FieldComponent[fieldID, i] is the inert i-th component of a Field.", 
   "Usage"], Cell["Status: Alpha.", "Notes"], Cell["FieldComponent[fieldID, \
i] is the inert i-th component of the Field with ID fieldID: an ordinary \
commuting scalar variable in polynomials.", "Notes"], 
  Cell["Distinct fields have distinct components even when they transform in \
the same irrep; repeating one field in a contraction repeats the same \
components.", "Notes"], Cell["N leaves components unchanged (the index stays \
an integer), so numerical coefficients can be introduced with N without \
corrupting the variables.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["FieldComponents", BaseStyle -> "Hyperlink", 
      ButtonData -> {"FieldComponents.nb", None}], "  |  ", 
     ButtonBox["Field", BaseStyle -> "Hyperlink", 
      ButtonData -> {"Field.nb", None}], "  |  ", ButtonBox["Coupling", 
      BaseStyle -> "Hyperlink", ButtonData -> {"Coupling.nb", None}]}], 
   "SeeAlso"], Cell["Examples Initialization", 
   "ExamplesInitializationSection"], Cell["Open this notebook in its \
repository location. GAP must be installed; LINS is required for its bounded \
search page. Evaluate the setup before the examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "sign", ",", "l", ",", "r", ",", "m"}], "}"}], 
        ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"sign", "=", RowBox[{"First", "[", RowBox[{"DeleteCases", 
                "[", RowBox[{RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                        "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                         {RowBox[{"RepDim", "[", RowBox[
                          {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "1"}], "&"}]}], "]"}], 
                  ",", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", "]"}], 
                    "[", "\"TrivialIrrepID\"", "]"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"{", RowBox[{RowBox[{"Head", "[", RowBox[{"First", "[", 
                  RowBox[{"FieldComponents", "[", "l", "]"}], "]"}], "]"}], 
              ",", RowBox[{RowBox[{"N", "[", RowBox[{"First", "[", 
                    RowBox[{"FieldComponents", "[", "l", "]"}], "]"}], "]"}], 
                "===", RowBox[{"First", "[", RowBox[{"FieldComponents", "[", 
                    "l", "]"}], "]"}]}]}], "}"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"FieldComponent", ",", "True"}], "}"}]], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"FieldComponents", "[", 
        "\"no field\"", "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/FieldComponent", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "FieldComponent \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
