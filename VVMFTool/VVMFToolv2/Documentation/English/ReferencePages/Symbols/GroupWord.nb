Notebook[{Cell["GroupWord", "ObjectName"], Cell["GroupWord[syllables] denotes \
an ordered generator word. GroupWord[text] denotes a word parsed in the \
receiving group's generators.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["GroupWord[{{\"a\",1},{\"b\",-2}}] is the ordered product a b^-2. \
GroupWord[{}] is the identity. Text accepts named generators, integer powers, \
parentheses and . or * for ordered multiplication.", "Notes"], 
  Cell["Words are inert data. The receiving operation validates names and \
syntax without evaluating the text. Free reduction does not impose unproved \
group relations.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["GroupWordOrder", BaseStyle -> "Hyperlink", 
      ButtonData -> {"GroupWordOrder.nb", None}], "  |  ", 
     ButtonBox["GroupPresentation", BaseStyle -> "Hyperlink", 
      ButtonData -> {"GroupPresentation.nb", None}], "  |  ", 
     ButtonBox["AssignModularGenerators", BaseStyle -> "Hyperlink", 
      ButtonData -> {"AssignModularGenerators.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                   {RowBox[{"{", RowBox[{"\"a\"", ",", "\"b\""}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"\"a^2\"", ",", "\"b^3\"", ",", 
                        "\"(a.b)^3\""}], "}"}]}], "]"}], ",", RowBox[
                 {"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"GroupWordOrder", "[", 
          RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"(a.b)^3\"", "]"}]}], 
          "]"}]}], "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["1"], "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"CatalogueGroup", "[", RowBox[
                   {"\"CyclicGroup\"", ",", "3"}], "]"}], ",", 
                RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"FailureQ", "[", RowBox[{"GroupWordOrder", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"unknown\"", 
                "]"}]}], "]"}], "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/GroupWord", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "GroupWord \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
