Notebook[{Cell["FormComponent", "ObjectName"], Cell["FormComponent[slotID, i] \
is the inert i-th component of a formal modular-form slot of a modular model \
(a symbolic Y copy).", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["FormComponent[slotID, i] is the inert i-th component of a formal \
modular-form slot of a modular model (a symbolic Y copy); N leaves it \
unevaluated.", "Notes"], Cell["Slot IDs come from ModularFormCandidates; a \
model registers a slot when a term using it is added, and only registered \
slot components may appear in a modular model's terms.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormCandidates", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormCandidates.nb", None}], "  |  ", 
     ButtonBox["ModularContractions", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularContractions.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"N", "[", RowBox[{"FormComponent", "[", 
        RowBox[{"\"slot:x\"", ",", "2"}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"FormComponent", "[", 
      RowBox[{"\"slot:x\"", ",", "2"}], "]"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"CoupleExpressions", "[", 
        RowBox[{RowBox[{"{", RowBox[{"FormComponent", "[", RowBox[{"\"s\"", 
                ",", "1"}], "]"}], "}"}], ",", RowBox[{"Couplings", 
            "\[Rule]", RowBox[{"{", RowBox[{"FormComponent", "[", 
                RowBox[{"\"s\"", ",", "1"}], "]"}], "}"}]}]}], "]"}], "]"}]], 
   "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/FormComponent", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "FormComponent \[LongDash] VVMFTool", 
