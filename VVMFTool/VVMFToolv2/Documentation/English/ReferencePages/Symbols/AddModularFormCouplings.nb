Notebook[{Cell["AddModularFormCouplings", "ObjectName"], 
  Cell["AddModularFormCouplings[m] multiplies every used formal form slot of \
the modular model m by its own physical coupling in every term (recorded, so \
repeating it adds nothing); AddModularFormCouplings[m, slotIDs] selects \
slots.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["AddModularFormCouplings[m] multiplies every used formal form slot of \
the model by its own physical coupling in every term; \
AddModularFormCouplings[m, slotIDs] selects slots.", "Notes"], 
  Cell["Repeated application reuses the recorded couplings (no second \
factor). Options: FormCouplings, CouplingPrefix (default \"a\"), \
ParameterSymbols.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["FormCouplings"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic (default) makes a fresh coupling per \
selected slot; an association from exactly the selected slot IDs to \
coefficients uses those (declare symbols with ParameterSymbols).", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["CouplingPrefix"], "TableText"], 
       Cell["\"a\"", "TableText"], Cell["A string (default \"c\").", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ParameterSymbols"], "TableText"], 
       Cell["{}", "TableText"], Cell["{} (default) or a duplicate-free list \
of symbols or indexed atoms; known constants such as Pi need no declaration. \
A spelling that already labels a parameter in this session gets a suffixed \
label (lambda_2): to share one parameter between terms, use its Coupling atom \
from CouplingParameters.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Verification"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic, \"Exact\", \"Numerical\" or None (the \
Validate functions: Automatic, \"Exact\" or \"Numerical\"; the modular-form \
functions have no \"Exact\" route).", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularContractions", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularContractions.nb", None}], "  |  ", 
     ButtonBox["ExtractBilinearMatrix", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ExtractBilinearMatrix.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "c", ",", "d", ",", "one", ",", "df", ",", "rf", ",", 
            "m0"}], "}"}], ",", RowBox[{RowBox[{"AssignModularGenerators", 
            "[", RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"c", "=", RowBox[{"RepresentationContext", "[", "g", 
              "]"}]}], ";", RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"one", "=", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", 
                "]"}], "[", "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"df", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "d", ",", "\"D\""}], "]"}]}], ";", 
          RowBox[{"rf", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "one", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m0", "=", RowBox[{"CreateModularModel", "[", 
              RowBox[{"c", ",", RowBox[{"{", RowBox[{"df", ",", "rf"}], 
                  "}"}], ",", RowBox[{"FieldWeights", "\[Rule]", 
                  RowBox[{"Association", "[", RowBox[{RowBox[{RowBox[{"df", 
                          "[", "\"ID\"", "]"}], "\[Rule]", "1"}], ",", 
                      RowBox[{RowBox[{"rf", "[", "\"ID\"", "]"}], "\[Rule]", 
                        "1"}]}], "]"}]}]}], "]"}]}], ";", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"m", "=", 
                  RowBox[{"AddModelTerm", "[", RowBox[{"m0", ",", RowBox[
                       {"CoupleContractions", "[", RowBox[
                         {"ModularContractions", "[", RowBox[{"m0", ",", 
                          RowBox[{"{", RowBox[{"df", ",", "rf"}], "}"}]}], 
                          "]"}], "]"}]}], "]"}]}], "}"}], ",", 
              RowBox[{"Length", "[", RowBox[{"ModelParameters", "[", 
                  RowBox[{"AddModularFormCouplings", "[", "m", "]"}], "]"}], 
                "]"}]}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["2"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"AddModularFormCouplings", 
        "[", "1", "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
