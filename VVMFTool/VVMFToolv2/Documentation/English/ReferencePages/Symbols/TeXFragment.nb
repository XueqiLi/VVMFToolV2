Notebook[{Cell["TeXFragment", "ObjectName"], Cell["TeXFragment[\"tex\"] marks \
explicitly supplied raw TeX for display labels and captions; ordinary strings \
are escaped text. It is shown literally in notebooks and never evaluated.", 
   "Usage"], Cell["Status: Alpha.", "Notes"], Cell["TeXFragment[\"tex\"] \
marks explicitly supplied raw TeX, for IrrepLabels and Caption. Ordinary \
strings are escaped as text; a TeXFragment is inserted into LaTeX as given.", 
   "Notes"], Cell["Notebook views show a TeXFragment as its literal source \
text; it is never parsed, evaluated or compiled. It is an output escape \
hatch, not a way to supply group data.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["IrrepLabels", BaseStyle -> "Hyperlink", 
      ButtonData -> {"IrrepLabels.nb", None}], "  |  ", 
     ButtonBox["Caption", BaseStyle -> "Hyperlink", 
      ButtonData -> {"Caption.nb", None}], "  |  ", 
     ButtonBox["ToLaTeX", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ToLaTeX.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"ComputeRepresentations", "\[Rule]", "False"}], 
                  ",", RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], 
                "]"}]}], ",", "id"}], "}"}], ",", 
        RowBox[{RowBox[{"id", "=", RowBox[{"First", "[", RowBox[{"g", "[", 
                "\"IrrepOrder\"", "]"}], "]"}]}], ";", 
          RowBox[{"StringContainsQ", "[", RowBox[{RowBox[{"ToLaTeX", "[", 
                RowBox[{"CharacterTableView", "[", RowBox[{"g", ",", 
                    RowBox[{"IrrepLabels", "\[Rule]", RowBox[{"Association", 
                        "[", RowBox[{"id", "\[Rule]", InterpretationBox[
                          TemplateBox[{"\"TeXFragment[\"", StyleBox[
                          "\"\\\\mathcal{A}\"", "Program", StripOnInput -> 
                          False], "\"]\""}, "RowDefault"], TeXFragment[
                          "\\mathcal{A}"]]}], "]"}]}]}], "]"}], "]"}], ",", 
              "\"\\\\mathcal{A}\""}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                   {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", ",", 
                        "\"(s.t)^3\""}], "}"}]}], "]"}], ",", RowBox[
                 {"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"FailureQ", "[", RowBox[{"CharacterTableView", 
            "[", RowBox[{"g", ",", RowBox[{"IrrepLabels", "\[Rule]", 
                RowBox[{"Association", "[", RowBox[{RowBox[{"First", "[", 
                      RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], "]"}], 
                    "\[Rule]", RowBox[{"TeXFragment", "[", "3", "]"}]}], 
                  "]"}]}]}], "]"}], "]"}]}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/TeXFragment", "Categorization", CellLabel -> "URI"]}, 
