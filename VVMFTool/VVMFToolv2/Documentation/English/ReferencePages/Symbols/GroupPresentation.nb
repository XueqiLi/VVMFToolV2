Notebook[{Cell["GroupPresentation", "ObjectName"], 
  Cell["GroupPresentation[names, relators] specifies a group by ordered \
generator names and words equal to the identity.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["GroupPresentation[names,relators] \
keeps the ordered names and relator words. Each relator equals the identity. \
Names must be distinct identifiers beginning with a letter; subsequent \
letters, digits and underscores are allowed.", "Notes"], 
  Cell["Relators may mix GroupWord values and text. No relators does not \
establish finiteness. BuildGroup establishes finite order within the \
requested resources.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BuildGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildGroup.nb", None}], "  |  ", 
     ButtonBox["GroupWord", BaseStyle -> "Hyperlink", 
      ButtonData -> {"GroupWord.nb", None}], "  |  ", 
     ButtonBox["NormalSubgroupsByIndex", BaseStyle -> "Hyperlink", 
      ButtonData -> {"NormalSubgroupsByIndex.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"BuildGroup", "[", 
              RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                   {RowBox[{"{", RowBox[{"\"a\"", ",", "\"b\""}], "}"}], ",", 
                    RowBox[{"{", RowBox[{"\"a^2\"", ",", "\"b^3\"", ",", 
                        "\"(a.b)^3\""}], "}"}]}], "]"}], ",", RowBox[
                 {"ComputeRepresentations", "\[Rule]", "False"}], ",", 
                RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
          "}"}], ",", RowBox[{"{", RowBox[{RowBox[{"g", "[", "\"Order\"", 
              "]"}], ",", RowBox[{"NumberOfRep", "[", "g", "]"}]}], "}"}]}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"12", ",", "4"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"BuildGroup", "[", 
        RowBox[{RowBox[{"GroupPresentation", "[", 
            RowBox[{RowBox[{"{", RowBox[{"\"a\"", ",", "\"a\""}], "}"}], ",", 
              RowBox[{"{", "\"a^2\"", "}"}]}], "]"}], ",", 
          RowBox[{"ComputeRepresentations", "\[Rule]", "False"}]}], "]"}], 
      "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/GroupPresentation", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "GroupPresentation \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
