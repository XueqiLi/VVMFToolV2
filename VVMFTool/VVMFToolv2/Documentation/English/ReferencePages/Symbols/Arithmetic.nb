Notebook[{Cell["Arithmetic", "ObjectName"], Cell["Arithmetic selects \
\"Exact\" (default) or explicitly \"Numerical\" representation arithmetic.", 
   "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for UnitarizeRepresentation, DiagonalizeRepresentationT, \
RepresentationTSpectrum, RepresentationCharacter, ValidateRepresentation, \
DecomposeRepresentation and TransformGroupRepresentations. Default: \
\"Exact\".", "Notes"], Cell["\"Exact\" proves identities exactly and refuses \
numerical input; \"Numerical\" works at WorkingPrecision (default 50) and \
checks residuals against Tolerance (default 10^(-Floor[p/2])). Tolerance is \
accepted only with numerical arithmetic.", "Notes"], 
  Cell["The owning function rejects other values before computation.", 
   "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["UnitarizeRepresentation", 
      BaseStyle -> "Hyperlink", ButtonData -> {"UnitarizeRepresentation.nb", 
