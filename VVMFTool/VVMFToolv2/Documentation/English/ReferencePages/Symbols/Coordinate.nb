Notebook[{Cell["Coordinate", "ObjectName"], Cell["Coordinate is an option of \
ModularFormDefinition and the scalar recipe functions: \"q\" (default) or \
\"tau\".", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option of ModularFormDefinition and the scalar recipe functions: the \
independent coordinate.", "Notes"], 
  Cell["\"q\" (default) or \"tau\". Other values fail with InvalidOption.", 
   "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ScalarQSeries", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ScalarQSeries.nb", None}], "  |  ", 
     ButtonBox["ModularFormDefinition", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormDefinition.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{RowBox[{"QExpansionCoefficients", "[", 
        RowBox[{"ScalarQSeries", "[", RowBox[
           {RowBox[{RowBox[{"Exp", "[", RowBox[{"2", " ", "\[Pi]", " ", 
                  "\[ImaginaryI]", " ", "tau"}], "]"}], " ", 
              RowBox[{"ScalarModularExpression", "[", RowBox[{"\"E4\"", ",", 
                  "tau", ",", RowBox[{"Coordinate", "\[Rule]", "\"tau\""}]}], 
                "]"}]}], ",", "tau", ",", "3", ",", 
            RowBox[{"Coordinate", "\[Rule]", "\"tau\""}]}], "]"}], "]"}], 
      "[", "\"Components\"", "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"Association", "[", 
        RowBox[{RowBox[{"1", "\[Rule]", "1"}], ",", 
          RowBox[{"2", "\[Rule]", "240"}]}], "]"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ScalarQSeries", "[", 
        RowBox[{"q", ",", "q", ",", "2", ",", RowBox[{"Coordinate", 
            "\[Rule]", "\"z\""}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/Coordinate", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "Coordinate \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
