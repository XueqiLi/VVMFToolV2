Notebook[{Cell["CoupleExpressions", "ObjectName"], 
  Cell["CoupleExpressions[{e1, e2, ...}] attaches one coefficient to each \
nonzero scalar expression; the term's symmetry is unverified until it is \
added to a model.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["CoupleExpressions[{e1, e2, ...}] attaches one coefficient to each \
scalar expression that is not proved zero and returns a CoupledExpression \
whose symmetry is Unverified.", "Notes"], Cell["It makes no independence or \
covariance claim; AddModelTerm checks covariance when the term joins a model. \
Options: Couplings, ParameterSymbols, CouplingPrefix, Arithmetic, \
WorkingPrecision and Tolerance; approximate numbers need Arithmetic -> \
\"Numerical\". A numerical Tolerance below 10^-digits of the data's precision \
fails with InvalidOption.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Couplings"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic (default, one fresh Coupling per \
retained term) or a list of coefficient expressions, one per retained term.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["CouplingPrefix"], "TableText"], 
       Cell["\"c\"", "TableText"], Cell["A string (default \"c\").", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ParameterSymbols"], "TableText"], 
       Cell["{}", "TableText"], Cell["{} (default) or a duplicate-free list \
of symbols or indexed atoms; known constants such as Pi need no declaration. \
A spelling that already labels a parameter in this session gets a suffixed \
label (lambda_2): to share one parameter between terms, use its Coupling atom \
from CouplingParameters.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Arithmetic"], "TableText"], Cell["\"Exact\"", 
        "TableText"], Cell["\"Exact\" proves identities exactly and refuses \
numerical input; \"Numerical\" works at WorkingPrecision (default 50) and \
checks residuals against Tolerance (default 10^(-Floor[p/2])). Tolerance is \
accepted only with numerical arithmetic.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["WorkingPrecision"], 
        "TableText"], Cell["50", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["Tolerance"], "TableText"], 
       Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["CoupleContractions", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CoupleContractions.nb", None}], "  |  ", 
     ButtonBox["ParameterSymbols", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ParameterSymbols.nb", None}], "  |  ", 
     ButtonBox["AddModelTerm", BaseStyle -> "Hyperlink", 
      ButtonData -> {"AddModelTerm.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"x", ",", RowBox[{"g", "=", 
              RowBox[{"BuildGroup", "[", RowBox[{RowBox[{"GroupPresentation", 
                    "[", RowBox[{RowBox[{"{", RowBox[{"\"s\"", ",", 
                          "\"t\""}], "}"}], ",", RowBox[{"{", RowBox[
                         {"\"s^2\"", ",", "\"t^2\"", ",", "\"(s.t)^3\""}], 
                        "}"}]}], "]"}], ",", RowBox[{"StoreGAPState", 
                    "\[Rule]", "False"}]}], "]"}]}], ",", "d", ",", "sign", 
            ",", "l", ",", "r", ",", "m"}], "}"}], ",", 
        RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", 
                "[", RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"sign", "=", RowBox[{"First", "[", 
              RowBox[{"DeleteCases", "[", RowBox[{RowBox[{"Select", "[", 
                    RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                      RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                          {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "1"}], "&"}]}], "]"}], 
                  ",", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", "]"}], 
                    "[", "\"TrivialIrrepID\"", "]"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"x", "=", RowBox[{"FieldComponents", "[", "l", "]"}]}], 
          ";", RowBox[{"Lookup", "[", RowBox[{RowBox[{"CouplingParameters", 
                "[", RowBox[{"CoupleExpressions", "[", RowBox[
                   {RowBox[{"{", RowBox[{SuperscriptBox[RowBox[{"x", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], "2"], ",", "0", ",", 
                        SuperscriptBox[RowBox[{"x", "\[LeftDoubleBracket]", 
                          "2", "\[RightDoubleBracket]"}], "2"]}], "}"}], ",", 
                    RowBox[{"Couplings", "\[Rule]", RowBox[{"{", RowBox[
                         {"alpha", ",", "beta"}], "}"}]}], ",", RowBox[
                     {"ParameterSymbols", "\[Rule]", RowBox[{"{", RowBox[
                         {"alpha", ",", "beta"}], "}"}]}]}], "]"}], "]"}], 
              ",", "\"Label\""}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"\"alpha\"", ",", "\"beta\""}], "}"}]], 
   "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"CoupleExpressions", "[", 
        RowBox[{"{", "1.5`", "}"}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/CoupleExpressions", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "CoupleExpressions \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
