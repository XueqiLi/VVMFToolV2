Notebook[{Cell["ExpressionMode", "ObjectName"], 
  Cell["ExpressionMode is an option of ModularFormView and ModularFormTable: \
\"Normalized\" (stored resolved coefficients substituted) or \"Raw\" \
(normalization parameters shown).", "Usage"], Cell["Status: Alpha.", 
   "Notes"], Cell["Option of ModularFormView and ModularFormTable: \
\"Normalized\" substitutes the stored resolved coefficients, \"Raw\" shows \
the normalization parameters.", "Notes"], Cell["Default \"Normalized\"; \
unresolved coefficients show the raw expression with the status Unresolved \
and assign no value.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormView", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormView.nb", None}], "  |  ", 
     ButtonBox["ModularFormGetCoeff", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormGetCoeff.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Lookup", "[", 
      RowBox[{RowBox[{"Options", "[", "ModularFormView", "]"}], ",", 
        "ExpressionMode"}], "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["\"Normalized\""], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ModularDimensionView", "[", 
        RowBox[{RowBox[{"Association", "[", "]"}], ",", 
          RowBox[{"ExpressionMode", "\[Rule]", "\"Raw\""}]}], "]"}], "]"}]], 
   "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
