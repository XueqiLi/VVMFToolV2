Notebook[{Cell["IrrepLabel", "ObjectName"], Cell["IrrepLabel[g, irrep] gives \
the user label of an irrep (index or ID) as plain text, or \
Missing[\"NoLabel\"]. IrrepLabel[g, irrep, \"Display\"] gives it typeset as \
in the views (super- and subscripts, accents); IrrepLabel[g, irrep, \"TeX\"] \
gives its LaTeX.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["IrrepLabel[g, irrep] gives the user label of an irrep (index or ID) \
as plain text, or Missing[\"NoLabel\"]. The library group 24-3I carries the \
paper's labels.", "Notes"], Cell["IrrepLabel[g, irrep, \"Display\"] gives the \
label typeset as in the views (bold base, primes, super- and subscripts, \
accents), for use in your own Row, Grid or Column; it evaluates to the plain \
text. IrrepLabel[g, irrep, \"TeX\"] gives its LaTeX.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["SetIrrepLabels", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SetIrrepLabels.nb", None}], "  |  ", 
     ButtonBox["IrrepIndex", BaseStyle -> "Hyperlink", 
      ButtonData -> {"IrrepIndex.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"IrrepLabel", "[", 
      RowBox[{RowBox[{"LoadGroup", "[", RowBox[{"\"24-3I\"", ",", 
            RowBox[{"Fresh", "\[Rule]", "True"}]}], "]"}], ",", "6"}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["\"2''\""], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"IrrepLabel", "[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/IrrepLabel", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "IrrepLabel \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
