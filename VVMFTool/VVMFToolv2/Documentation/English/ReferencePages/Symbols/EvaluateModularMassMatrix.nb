Notebook[{Cell["EvaluateModularMassMatrix", "ObjectName"], 
  Cell["EvaluateModularMassMatrix[m, mass, point] validates the matrix \
against the modular model m and evaluates its entries at the point with the \
bound forms and the given inputs; EstimatedError is the matrix's own estimate \
(largest entry), as for EvaluateModularModel.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["EvaluateModularMassMatrix[m, mass, \
point] validates the matrix against the model (source, covariance, entry \
weights) and evaluates its entries at the point; the 2D shape is kept.", 
   "Notes"], Cell["The matrix is one output: its EstimatedError, acceptance \
and refinement follow EvaluateModularModel, using the largest entry.", 
   "Notes"], Cell["The report's \"VerificationStatus\" is at best \
\"Numerical\", bounded by the matrix's validation (ValidateMassMatrix) and \
the bound forms' statuses.", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["ParameterValues"], "TableText"], 
       Cell["<||>", "TableText"], Cell["<||> (default). Fixed parameters are \
recorded in the output and its manifest and are not Python inputs; fixing a \
coupling to 1 is an explicit choice, never an automatic scale removal. \
Unknown IDs or values with parameters, fields or infinities fail with \
InvalidOption.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["FieldValues"], "TableText"], Cell["<||>", "TableText"], 
       Cell["An association from field IDs to full ordered vectors of finite \
numbers (default <||>); a required field without a value fails \
MissingFieldValues, a wrong length InvalidFieldValues.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["WorkingPrecision"], 
        "TableText"], Cell["50", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["AccuracyGoal"], "TableText"], 
       Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["PrecisionGoal"], 
        "TableText"], Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["SeriesOrder"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic (default: chosen from \
the accuracy goal and the point, or 6 orders for construction checks) or a \
positive integer; an explicit order is required to evaluate a finite jet (the \
result then has EstimatedError Missing[\"NoTailBound\"] or the next-order \
difference).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["MaxSeriesOrder"], "TableText"], 
       Cell["2000", "TableText"], Cell["2000 (default) or a positive integer; \
reaching it fails with ConvergenceFailure and the best estimate.", 
        "TableText"]}, {Cell[" ", "TableRowIcon"], Cell[BoxData["TimeLimit"], 
        "TableText"], Cell["600", "TableText"], Cell["600 (default), a \
positive number or Infinity; exceeding it fails with TimeLimit and changes \
nothing.", "TableText"]}}, GridBoxAlignment -> {"Columns" -> {{Left}}}, 
     GridBoxItemSize -> {"Columns" -> {Scaled[0.02], Scaled[0.3], 
         Scaled[0.18], Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["EvaluateModularModel", BaseStyle -> "Hyperlink", 
      ButtonData -> {"EvaluateModularModel.nb", None}], "  |  ", 
     ButtonBox["ExtractBilinearMatrix", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ExtractBilinearMatrix.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "c", ",", "d", ",", "one", ",", "df", ",", "rf", ",", 
            "m0"}], "}"}], ",", RowBox[{RowBox[{"AssignModularGenerators", 
            "[", RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"c", "=", RowBox[{"RepresentationContext", "[", "g", 
              "]"}]}], ";", RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"one", "=", RowBox[{RowBox[{"g", "[", "\"CharacterData\"", 
                "]"}], "[", "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"df", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "d", ",", "\"D\""}], "]"}]}], ";", 
          RowBox[{"rf", "=", RowBox[{"CreateField", "[", RowBox[{"c", ",", 
                "one", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m0", "=", RowBox[{"CreateModularModel", "[", 
              RowBox[{"c", ",", RowBox[{"{", RowBox[{"df", ",", "rf"}], 
                  "}"}], ",", RowBox[{"FieldWeights", "\[Rule]", 
                  RowBox[{"Association", "[", RowBox[{RowBox[{RowBox[{"df", 
                          "[", "\"ID\"", "]"}], "\[Rule]", "1"}], ",", 
                      RowBox[{RowBox[{"rf", "[", "\"ID\"", "]"}], "\[Rule]", 
                        "1"}]}], "]"}]}]}], "]"}]}], ";", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"m", "=", RowBox[{"AddModelTerm", "[", RowBox[
                       {"m0", ",", RowBox[{"CoupleContractions", "[", 
                          RowBox[{"ModularContractions", "[", RowBox[{"m0", 
                          ",", RowBox[{"{", RowBox[{"df", ",", "rf"}], 
                          "}"}]}], "]"}], "]"}]}], "]"}]}], ",", 
                  RowBox[{"y", "=", RowBox[{"First", "[", RowBox[
                       {"ConstructModularForms", "[", RowBox[{"c", ",", 
                          "d"}], "]"}], "]"}]}], ",", "slot", ",", "mb", ",", 
                  "values"}], "}"}], ",", RowBox[{RowBox[
                 {"ModularFormGetCoeff", "[", RowBox[{"y", ",", RowBox[
                     {"WorkingPrecision", "\[Rule]", "30"}]}], "]"}], ";", 
                RowBox[{"slot", "=", RowBox[{"First", "[", RowBox[{"Keys", 
                      "[", RowBox[{RowBox[{RowBox[{"First", "[", "m", "]"}], 
                          "[", "\"ModularData\"", "]"}], "[", "\"Slots\"", 
                        "]"}], "]"}], "]"}]}], ";", RowBox[{"mb", "=", 
                  RowBox[{"BindModularForms", "[", RowBox[{"m", ",", 
                      RowBox[{"Association", "[", RowBox[{"slot", "\[Rule]", 
                          "y"}], "]"}]}], "]"}]}], ";", RowBox[{"values", 
                  "=", RowBox[{"AssociationThread", "[", RowBox[
                     {RowBox[{"Lookup", "[", RowBox[{RowBox[
                          {"ModelParameters", "[", "mb", "]"}], ",", 
                          "\"ID\""}], "]"}], ",", RowBox[{"ConstantArray", 
                        "[", RowBox[{"1", ",", RowBox[{"Length", "[", RowBox[
                          {"ModelParameters", "[", "mb", "]"}], "]"}]}], 
                        "]"}]}], "]"}]}], ";", RowBox[{"Dimensions", "[", 
                  RowBox[{RowBox[{"EvaluateModularMassMatrix", "[", 
                      RowBox[{"mb", ",", RowBox[{"ExtractBilinearMatrix", 
                          "[", RowBox[{RowBox[{"ModelExpression", "[", "mb", 
                          "]"}], ",", "df", ",", "rf"}], "]"}], ",", 
                        InterpretationBox[TemplateBox[{"\"TauPoint[\"", 
                          "\[ImaginaryI]", "\"]\""}, "RowDefault"], TauPoint[
                          I]], ",", RowBox[{"ParameterValues", "\[Rule]", 
                          "values"}]}], "]"}], "[", "\"Value\"", "]"}], 
                  "]"}]}]}], "]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{"2", ",", "1"}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"EvaluateModularMassMatrix", 
        "[", RowBox[{"5", ",", "6", ",", "7"}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/EvaluateModularMassMatrix", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "EvaluateModularMassMatrix \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
