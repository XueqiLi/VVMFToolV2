Notebook[{Cell["SetClassLabels", "ObjectName"], 
  Cell["SetClassLabels[g, names] sets the names of the conjugacy classes of g \
(a list in class order, entries name or {name, representative word}, or an \
association class -> name).", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["SetClassLabels[g, names] stores names of the conjugacy classes of g: \
a list in class order (None for no name; an entry may be {name, \
representative word}) or an association class (index or ID) -> name. Names \
such as 4C_{3}^{1} render as text, boxes and LaTeX; CharacterTableView uses \
them as column headers.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ReorderGroupClasses", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ReorderGroupClasses.nb", None}], "  |  ", 
     ButtonBox["CharacterTableView", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CharacterTableView.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"LoadGroup", "[", 
              RowBox[{"\"24-3I\"", ",", RowBox[{"Fresh", "\[Rule]", 
                  "True"}]}], "]"}]}], "}"}], ",", 
        RowBox[{RowBox[{"SetClassLabels", "[", RowBox[{"g", ",", 
              RowBox[{"Association", "[", RowBox[{"1", "\[Rule]", "\"e\""}], 
                "]"}]}], "]"}], ";", RowBox[
           {RowBox[{"g", "[", "\"ClassLabels\"", "]"}], "[", "1", "]"}]}]}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["\"e\""], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"SetClassLabels", "[", 
        RowBox[{"1", ",", RowBox[{"{", "}"}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
