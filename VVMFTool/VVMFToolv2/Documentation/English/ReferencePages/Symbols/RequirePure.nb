Notebook[{Cell["RequirePure", "ObjectName"], Cell["RequirePure specifies \
whether matrix extraction fails unless the selected sector is the whole \
expression.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for ExtractBilinearMatrix and ExtractQuadraticMatrix: whether \
terms outside the selected sector are allowed; with False they are kept in \
Remainder.", "Notes"], Cell["False (default) or True (fail with ImpureSector \
unless the remainder is zero).", "Notes"], 
  Cell["Other values fail with InvalidOption.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ExtractBilinearMatrix", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ExtractBilinearMatrix.nb", None}], "  |  ", 
     ButtonBox["ExtractQuadraticMatrix", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ExtractQuadraticMatrix.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ExtractQuadraticMatrix", 
        "[", RowBox[{RowBox[{SuperscriptBox["p", "2"], "+", "1"}], ",", 
          RowBox[{"{", "p", "}"}], ",", RowBox[{"RequirePure", "\[Rule]", 
            "True"}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ExtractQuadraticMatrix", 
        "[", RowBox[{SuperscriptBox["p", "2"], ",", RowBox[{"{", "p", "}"}], 
          ",", RowBox[{"RequirePure", "\[Rule]", "\"yes\""}]}], "]"}], 
      "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
