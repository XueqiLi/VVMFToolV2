Notebook[{Cell["MassMatrices", "ObjectName"], Cell["MassMatrices gives the \
named coefficient matrices SaveModelData stores with a model: an association \
from names to MassMatrix values, each certified against the model.", 
   "Usage"], Cell["Status: Alpha.", "Notes"], Cell["Option for SaveModelData: \
named coefficient matrices stored with the model; each must be certified \
against the model by ValidateMassMatrix.", "Notes"], 
  Cell["<||> (default) or an association from names to MassMatrix values. \
Other values fail with InvalidOption.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["SaveModelData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SaveModelData.nb", None}], "  |  ", 
     ButtonBox["ImportModelData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ImportModelData.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "l", ",", "r", ",", "m", ",", "mass"}], "}"}], 
        ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
              RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                    "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                     {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                      "2"}], "&"}]}], "]"}], "]"}]}], ";", 
          RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"L\""}], "]"}]}], ";", 
          RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                "d", ",", "\"R\""}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], ";", 
          RowBox[{"m", "=", RowBox[{"AddModelTerm", "[", RowBox[{"m", ",", 
                RowBox[{"CoupleContractions", "[", RowBox[{"Contractions", 
                    "[", RowBox[{"m", ",", RowBox[{"{", RowBox[{"l", ",", 
                          "r"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";", 
          RowBox[{"mass", "=", RowBox[{"ExtractBilinearMatrix", "[", 
              RowBox[{RowBox[{"ModelExpression", "[", "m", "]"}], ",", "l", 
                ",", "r"}], "]"}]}], ";", RowBox[{"With", "[", 
            RowBox[{RowBox[{"{", RowBox[{"p", "=", RowBox[{"SaveModelData", 
                    "[", RowBox[{"m", ",", RowBox[{"FileNameJoin", "[", 
                        RowBox[{"{", RowBox[{"$TemporaryDirectory", ",", 
                          RowBox[{RowBox[{"CreateUUID", "[", "]"}], "<>", 
                          "\".json\""}]}], "}"}], "]"}], ",", RowBox[
                       {"MassMatrices", "\[Rule]", RowBox[{"Association", 
                          "[", RowBox[{"\"M\"", "\[Rule]", "mass"}], 
                          "]"}]}]}], "]"}]}], "}"}], ",", RowBox[{"Keys", 
                "[", RowBox[{RowBox[{"ImportModelData", "[", "p", "]"}], "[", 
                  "\"MassMatrices\"", "]"}], "]"}]}], "]"}]}]}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", "\"M\"", "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"Module", "[", 
        RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                  "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                       {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                        ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                    RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
              ",", "d", ",", "l", ",", "r", ",", "m", ",", "mass"}], "}"}], 
          ",", RowBox[{RowBox[{"d", "=", RowBox[{"First", "[", 
                RowBox[{"Select", "[", RowBox[{RowBox[{"g", "[", 
                      "\"IrrepOrder\"", "]"}], ",", RowBox[{RowBox[
                       {RowBox[{"RepDim", "[", RowBox[{"GroupRepresentation", 
                          "[", RowBox[{"g", ",", "#1"}], "]"}], "]"}], "===", 
                        "2"}], "&"}]}], "]"}], "]"}]}], ";", 
            RowBox[{"l", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                  "d", ",", "\"L\""}], "]"}]}], ";", 
            RowBox[{"r", "=", RowBox[{"CreateField", "[", RowBox[{"g", ",", 
                  "d", ",", "\"R\""}], "]"}]}], ";", 
            RowBox[{"m", "=", RowBox[{"CreateModel", "[", RowBox[{"g", ",", 
                  RowBox[{"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}]}], 
            ";", RowBox[{"m", "=", RowBox[{"AddModelTerm", "[", 
                RowBox[{"m", ",", RowBox[{"CoupleContractions", "[", 
                    RowBox[{"Contractions", "[", RowBox[{"m", ",", RowBox[
                         {"{", RowBox[{"l", ",", "r"}], "}"}]}], "]"}], 
                    "]"}]}], "]"}]}], ";", RowBox[{"mass", "=", 
              RowBox[{"ExtractBilinearMatrix", "[", RowBox[
                 {RowBox[{"ModelExpression", "[", "m", "]"}], ",", "l", ",", 
                  "r"}], "]"}]}], ";", RowBox[{"SaveModelData", "[", 
              RowBox[{"m", ",", RowBox[{"FileNameJoin", "[", RowBox[
                   {"{", RowBox[{"$TemporaryDirectory", ",", RowBox[
                       {RowBox[{"CreateUUID", "[", "]"}], "<>", 
                        "\".json\""}]}], "}"}], "]"}], ",", RowBox[
                 {"MassMatrices", "\[Rule]", RowBox[{"Association", "[", 
                    RowBox[{"\"M\"", "\[Rule]", "5"}], "]"}]}]}], "]"}]}]}], 
        "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/MassMatrices", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "MassMatrices \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
