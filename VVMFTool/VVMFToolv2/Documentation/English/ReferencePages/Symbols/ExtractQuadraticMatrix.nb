Notebook[{Cell["ExtractQuadraticMatrix", "ObjectName"], 
  Cell["ExtractQuadraticMatrix[expr, x] gives the symmetric M with selected \
== x . M . x (QuadraticConvention -> \"Half\": selected == (x . M . x)/2). \
Numerical input needs Arithmetic -> \"Numerical\".", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["ExtractQuadraticMatrix[expr, x] \
gives the symmetric M with selected == x . M . x, where selected is the part \
of expr of degree two in the variables x: diagonal entries are the x_i^2 \
coefficients and off-diagonal entries half the x_i x_j coefficients.", 
   "Notes"], Cell["QuadraticConvention -> \"Half\" gives selected == (x . M . \
x)/2 instead. ExtractQuadraticMatrix[expr, f] uses the components of a \
Field.", "Notes"], Cell["Options: QuadraticConvention, RequirePure, \
Arithmetic (\"Exact\" by default, or \"Numerical\" with WorkingPrecision and \
Tolerance; approximate input needs \"Numerical\").", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["QuadraticConvention"], "TableText"], 
       Cell["\"Polynomial\"", "TableText"], Cell["\"Polynomial\" (default, \
selected == x . M . x) or \"Half\" (selected == (x . M . x)/2, the Hessian \
matrix).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["RequirePure"], "TableText"], Cell["False", "TableText"], 
       Cell["False (default) or True (fail with ImpureSector unless the \
remainder is zero).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Arithmetic"], "TableText"], Cell["\"Exact\"", 
        "TableText"], Cell["\"Exact\" proves identities exactly and refuses \
numerical input; \"Numerical\" works at WorkingPrecision (default 50) and \
checks residuals against Tolerance (default 10^(-Floor[p/2])). Tolerance is \
accepted only with numerical arithmetic.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["WorkingPrecision"], 
        "TableText"], Cell["50", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["Tolerance"], "TableText"], 
       Cell["Automatic", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ExtractBilinearMatrix", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ExtractBilinearMatrix.nb", None}], "  |  ", 
     ButtonBox["QuadraticConvention", BaseStyle -> "Hyperlink", 
      ButtonData -> {"QuadraticConvention.nb", None}], "  |  ", 
     ButtonBox["MatrixValues", BaseStyle -> "Hyperlink", 
      ButtonData -> {"MatrixValues.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MatrixValues", "[", 
      RowBox[{"ExtractQuadraticMatrix", "[", 
        RowBox[{RowBox[{RowBox[{"a", " ", SuperscriptBox["p", "2"]}], "+", 
            RowBox[{"b", " ", "p", " ", "q"}], "+", 
            RowBox[{"c", " ", SuperscriptBox["q", "2"]}]}], ",", 
          RowBox[{"{", RowBox[{"p", ",", "q"}], "}"}]}], "]"}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{RowBox[{"{", RowBox[{"a", ",", FractionBox["b", "2"]}], 
          "}"}], ",", RowBox[{"{", RowBox[{FractionBox["b", "2"], ",", "c"}], 
          "}"}]}], "}"}]], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ExtractQuadraticMatrix", 
        "[", RowBox[{SuperscriptBox["p", "2"], ",", RowBox[{"{", "}"}]}], 
        "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
