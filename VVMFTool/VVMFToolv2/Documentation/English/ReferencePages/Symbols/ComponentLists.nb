Notebook[{Cell["ComponentLists", "ObjectName"], 
  Cell["ComponentLists gives the component lists of CGPolynomialResult: \
Automatic (distinct inert vectors) or {listA, listB}.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Option for CGPolynomialResult: \
Automatic (distinct inert vectors), {listA, listB} of explicit components, or \
symbols {a, b} naming the components a[1], ..., b[1], ... (as \
MakeRepVector).", "Notes"], 
  Cell["Automatic (default), {listA, listB} or {a, b} (lists or symbols).", 
   "Notes"], 
  Cell["The owning function rejects other values before any computation.", 
   "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["CGPolynomialResult", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CGPolynomialResult.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
