Notebook[{Cell["FieldWeights", "ObjectName"], Cell["FieldWeights is an option \
of CreateModularModel: an association from every field ID to its weight label \
kf, an exact rational such as 1/2 (actual weight -kf).", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Option of CreateModularModel: the \
weight label kf of every field, an exact rational such as 1/2 (actual modular \
weight -kf), as an association from field IDs.", "Notes"], 
  Cell["Required (Automatic fails MissingFieldWeights); unknown field IDs or \
labels that are not exact rationals (for example 0.5) fail \
InvalidFieldWeights. A term with one form of weight kY is admitted when kY - \
Sum kf = kW.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["CreateModularModel", BaseStyle -> "Hyperlink", 
      ButtonData -> {"CreateModularModel.nb", None}], "  |  ", 
     ButtonBox["SuperpotentialWeight", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SuperpotentialWeight.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Lookup", "[", 
      RowBox[{RowBox[{"Options", "[", "CreateModularModel", "]"}], ",", 
        "FieldWeights"}], "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["Automatic"], "Output"], Cell["Possible Issues", 
   "ExampleSection"], Cell["Invalid input returns a structured Failure. Check \
FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"CreateModularModel", "[", 
        RowBox[{"1", ",", RowBox[{"{", "}"}], ",", 
          RowBox[{"FieldWeights", "\[Rule]", "5"}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/FieldWeights", "Categorization", 
