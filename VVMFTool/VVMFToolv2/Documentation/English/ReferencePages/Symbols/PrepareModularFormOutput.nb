Notebook[{Cell["PrepareModularFormOutput", "ObjectName"], 
  Cell["PrepareModularFormOutput[<|name -> y, ...|>] gives a \
ModularFormOutput: an immutable export snapshot of named modular forms with \
frozen records, shared dependencies and a digest.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["PrepareModularFormOutput[<|name -> \
y, ...|>] snapshots named modular forms for export: every output is a vector \
(shape {d}, also d = 1) with its form ID and revision, weight, irrep, basis, \
assignment and group identities.", "Notes"], Cell["A form under several names \
shares one frozen node; the output carries every frozen record (definition, \
coefficients, anchor frame, stored expansion, evidence) and a content digest. \
Nothing is computed; Missing data stay Missing and ToPython decides what can \
be exported.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormOutput", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormOutput.nb", None}], "  |  ", 
     ButtonBox["ToPython", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ToPython.nb", None}], "  |  ", 
     ButtonBox["SaveModularFormData", BaseStyle -> "Hyperlink", 
      ButtonData -> {"SaveModularFormData.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "one", ",", "y"}], "}"}], ",", 
        RowBox[{RowBox[{"AssignModularGenerators", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"one", "=", RowBox[
             {RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
              "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"y", "=", RowBox[{"First", "[", RowBox[{
                "ConstructModularForms", "[", RowBox[{"g", ",", "d"}], "]"}], 
              "]"}]}], ";", RowBox[{"ModularFormGetCoeff", "[", 
            RowBox[{"y", ",", RowBox[{"WorkingPrecision", "\[Rule]", 
                "30"}]}], "]"}], ";", RowBox[
           {RowBox[{RowBox[{"PrepareModularFormOutput", "[", RowBox[
                 {"Association", "[", RowBox[{RowBox[{"\"Y\"", "\[Rule]", 
                      "y"}], ",", RowBox[{"\"Same\"", "\[Rule]", "y"}]}], 
                  "]"}], "]"}], "[", "\"Outputs\"", "]"}], 
            "\[LeftDoubleBracket]", RowBox[{"All", ",", "\"Shape\""}], 
            "\[RightDoubleBracket]"}]}]}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], 
  Cell[BoxData[RowBox[{"{", RowBox[{RowBox[{"{", "2", "}"}], ",", 
        RowBox[{"{", "2", "}"}]}], "}"}]], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"PrepareModularFormOutput", 
        "[", RowBox[{"Association", "[", RowBox[{"\"Y\"", "\[Rule]", "1"}], 
          "]"}], "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/PrepareModularFormOutput", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "PrepareModularFormOutput \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
