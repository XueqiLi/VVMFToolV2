Notebook[{Cell["SetCatalogueLabel", "ObjectName"], 
  Cell["SetCatalogueLabel[g, label] records the modular catalogue label of g \
(for example \"24-3I\"), which names the group in its display.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["SetCatalogueLabel[g, label] records \
the paper's label of g, which names the group in its output: Group[24-3I] \
(Group[24-3I$2] for a second group with the same label). The label has the \
form order-number with an optional roman suffix (24-3I, 78-1I) and its order \
and number must be the group's GAP ID; a label of the modular catalogue is \
also accepted for a group whose GAP ID is unknown. Groups without a label are \
named by their GAP ID, Group[[24,3]], with II, III for further groups of the \
same GAP ID. BuildModularGroup with a label and LoadGroup set it.", "Notes"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["BuildModularGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"BuildModularGroup.nb", None}], "  |  ", 
     ButtonBox["LoadGroup", BaseStyle -> "Hyperlink", 
      ButtonData -> {"LoadGroup.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{"g", "=", RowBox[{"LoadGroup", "[", 
              RowBox[{"\"24-3I\"", ",", RowBox[{"Fresh", "\[Rule]", 
                  "True"}]}], "]"}]}], "}"}], ",", 
        RowBox[{RowBox[{"SetCatalogueLabel", "[", RowBox[{"g", ",", "None"}], 
            "]"}], ";", RowBox[{"g", "[", "\"CatalogueLabel\"", "]"}]}]}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["None"], "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"SetCatalogueLabel", "[", 
        RowBox[{RowBox[{"LoadGroup", "[", RowBox[{"\"24-3I\"", ",", 
              RowBox[{"Fresh", "\[Rule]", "True"}]}], "]"}], ",", 
          "\"no-such-label\""}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/SetCatalogueLabel", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "SetCatalogueLabel \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
