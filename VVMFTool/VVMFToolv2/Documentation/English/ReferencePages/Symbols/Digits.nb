Notebook[{Cell["Digits", "ObjectName"], Cell["Digits limits the displayed \
digits of numerical values: Automatic or a positive integer. Exact values are \
never rounded.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option for the view producers, the renderers, ScalarLaTeX and \
MatrixLaTeX. Default: Automatic (the value's own precision).", "Notes"], 
  Cell["A positive integer limits the digits displayed for numerical values. \
Exact values are never rounded, and stored values are not changed.", 
   "Notes"], Cell["The owning function rejects other values before rendering \
or computation.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ScalarLaTeX", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ScalarLaTeX.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", "ScalarLaTeX", 
            "]"}]}], ",", "Digits"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/Digits", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "Digits \[LongDash] VVMFTool", 
