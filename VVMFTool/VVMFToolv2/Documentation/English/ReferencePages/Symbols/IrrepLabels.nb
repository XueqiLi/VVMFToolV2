Notebook[{Cell["IrrepLabels", "ObjectName"], Cell["IrrepLabels gives custom \
display labels: an association irrep ID -> string or TeXFragment.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], 
  Cell["Option for CharacterTableView and RepresentationTable. Default: \
<||>.", "Notes"], Cell["An association from known irrep IDs to plain strings \
(escaped) or TeXFragment values (raw TeX, shown literally in notebooks). \
Labels never replace the ID column.", "Notes"], 
  Cell[
   "The owning function rejects other values before rendering or \
computation.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["TeXFragment", BaseStyle -> "Hyperlink", 
      ButtonData -> {"TeXFragment.nb", None}], "  |  ", 
     ButtonBox["RepresentationTable", BaseStyle -> "Hyperlink", 
      ButtonData -> {"RepresentationTable.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", 
            "RepresentationTable", "]"}]}], ",", "IrrepLabels"}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/IrrepLabels", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "IrrepLabels \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
