Notebook[{Cell["Route", "ObjectName"], Cell["Route is an option of \
TransformGroupRepresentations: Automatic (GAP for native variants unless an \
option needs Wolfram), \"GAP\" or \"Wolfram\".", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["Option of \
TransformGroupRepresentations: Automatic (GAP for irreps with a native \
variant, unless an option is honoured only in Wolfram), \"GAP\" or \
\"Wolfram\".", "Notes"], Cell["Automatic, \"GAP\" or \"Wolfram\".", "Notes"], 
  Cell["Route -> \"GAP\" with an option only the Wolfram route honours is \
InapplicableOption: numerical arithmetic; a Spectral or explicit Cholesky/LDL \
factorization; numerical or explicit Exact T-diagonalization, or \
GeneratorEquations, with UnitaryTDiagonal; an explicit FieldMethod; \
WitnessVariant \"Active\" on a non-native active variant; or an irrep without \
a native variant. Route -> \"Wolfram\" transforms the active variants in \
Wolfram, where WorkingPrecision applies to numerical arithmetic and to the \
NumericalReconstruction diagonalization, and Tolerance to numerical \
arithmetic.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["TransformGroupRepresentations", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"TransformGroupRepresentations.nb", None}], "  |  ", 
     ButtonBox["WitnessVariant", BaseStyle -> "Hyperlink", 
      ButtonData -> {"WitnessVariant.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"MemberQ", "[", 
      RowBox[{RowBox[{"First", "/@", RowBox[{"Options", "[", 
            "TransformGroupRepresentations", "]"}]}], ",", "Route"}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], Cell[BoxData["True"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", 
      RowBox[{"TransformGroupRepresentations", "[", 
        RowBox[{"\"no group\"", ",", RowBox[{"Route", "\[Rule]", 
            "\"Wolfram\""}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/Route", "Categorization", CellLabel -> "URI"]}, 
    Closed]]}, WindowTitle -> "Route \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
