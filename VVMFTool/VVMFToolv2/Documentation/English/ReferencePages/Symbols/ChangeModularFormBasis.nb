Notebook[{Cell["ChangeModularFormBasis", "ObjectName"], 
  Cell["ChangeModularFormBasis[y, b] gives the modular form b . y with \
representation b rho b^-1 as a new object, without rescaling.", "Usage"], 
  Cell["Status: Alpha.", "Notes"], Cell["ChangeModularFormBasis[y, b] gives \
the form b . y with representation b rho b^-1 as a new object whose basis ID \
is the content identity of the new matrices (as a group's own variant of \
those matrices), without rescaling; the anchor frame becomes A . b^-1 (the \
same normalization functional), and expansions and definitions are \
transformed consistently.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormRep", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormRep.nb", None}], "  |  ", 
     ButtonBox["ModularFormCoefficients", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormCoefficients.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "one"}], "}"}], ",", 
        RowBox[{RowBox[{"AssignModularGenerators", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"one", "=", RowBox[
             {RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
              "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"y", "=", 
                  RowBox[{"First", "[", RowBox[{"ConstructModularForms", "[", 
                      RowBox[{"g", ",", "d"}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{RowBox[{"ModularFormRep", "[", RowBox[
                   {"ChangeModularFormBasis", "[", RowBox[{"y", ",", 
                      RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", 
                          "1"}], "}"}], ",", RowBox[{"{", RowBox[{"1", ",", 
                          "0"}], "}"}]}], "}"}]}], "]"}], "]"}], "=!=", 
                RowBox[{"ModularFormRep", "[", "y", "]"}]}]}], "]"}]}]}], 
      "]"}]], "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["True"], "Output"], Cell["Possible Issues", "ExampleSection"], 
  Cell["Invalid input returns a structured Failure. Check FailureQ before \
using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ChangeModularFormBasis", 
        "[", RowBox[{"5", ",", RowBox[{"{", RowBox[{"{", "1", "}"}], "}"}]}], 
        "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ChangeModularFormBasis", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "ChangeModularFormBasis \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
