Notebook[{Cell["ExportEvaluationMethod", "ObjectName"], 
  Cell["ExportEvaluationMethod is an option of ToPython for modular outputs: \
Automatic (\"QSeries\"), \"QSeries\", \"FiniteSeries\" (with SeriesOrder) or \
\"Analytic\" (unavailable).", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["Option of ToPython for modular outputs: Automatic (\"QSeries\": \
adaptive q-series of the frozen recipes), \"FiniteSeries\" (a stored \
expansion or finite jet at an explicit SeriesOrder) or \"Analytic\" \
(unavailable, as in Stage 7).", "Notes"], Cell["Default Automatic; \
FiniteSeries reports a finite approximation without a tail bound and refuses \
accuracy goals.", "Notes"], Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ToPython", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ToPython.nb", None}], "  |  ", 
     ButtonBox["FormEvaluation", BaseStyle -> "Hyperlink", 
      ButtonData -> {"FormEvaluation.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Lookup", "[", 
      RowBox[{RowBox[{"Options", "[", "ToPython", "]"}], ",", 
        "ExportEvaluationMethod"}], "]"}]], "Input", 
   CellTags -> "VerifiedExample"], Cell[BoxData["Automatic"], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ToPython", "[", 
        RowBox[{"1", ",", RowBox[{"ExportEvaluationMethod", "\[Rule]", 
            "\"Other\""}]}], "]"}], "]"}]], "Input", 
   CellTags -> "VerifiedErrorExample"], Cell[BoxData["True"], "Output"], 
  Cell["Related Guides", "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ExportEvaluationMethod", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "ExportEvaluationMethod \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
