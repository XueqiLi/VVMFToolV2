Notebook[{Cell["ValidateModularForm", "ObjectName"], 
  Cell["ValidateModularForm[y] gives a read-only report of the record, \
parity, exact T expansion, recipe, normalization and numerical S checks of \
the modular form y.", "Usage"], Cell["Status: Alpha.", "Notes"], 
  Cell["ValidateModularForm[y] gives a read-only report <|\"Checks\" -> \
<|\"RecordBinding\", \"Dimension\", \"Parity\", \"TExpansion\", \"Recipe\", \
\"Normalization\", \"STransformation\"|>, \"ProofStatus\", \"Remedies\"|> \
with each check's status (Proven, ExactThroughOrder, Numerical, NotAvailable, \
Failed).", "Notes"], Cell["Exact checks through an order and numerical \
samples are evidence, never a proof of a global identity; RequireProof -> \
True fails unless every check is a proof.", "Notes"], 
  Cell["Options: WorkingPrecision -> 40 (numerical samples; the S/T check \
passes below 10^-(WorkingPrecision/2)) and SeriesOrder -> Automatic (6 for \
the exact T and normalization checks; for the S/T samples an order covering \
the weight's coefficient growth and the series tail at the validation points, \
listed as \"Order\" in the STransformation check). An explicit SeriesOrder is \
used for every check. The validation points are disjoint from the \
normalization fit and holdout points.", "Notes"], 
  Cell["No implemented route produces Proven at present (there is no exact \
identity certificate, and the S check is sampled), so RequireProof -> True \
currently refuses every form and model result with ProofRequired.", "Notes"], 
  Cell["The report's \"VerificationStatus\" is the form's status: a new form \
is \"Unverified\"; a \"NumericalEvidence\" or \"Proven\" result is recorded \
in the form (its Validation \"Status\", at the same revision, so the bindings \
that pin the revision stay valid; it is saved with the form) and raises the \
status to \"Numerical\" or \"Exact\". New coefficients (ModularFormGetCoeff) \
reset it to \"Unverified\"; copies already bound into models keep their \
binding-time status. A normalization anchor that agrees only numerically is \
\"Numerical\", never \"Proven\".", "Notes"], 
  Cell["Options (shared configured settings can override these defaults):", 
   "Notes"], Cell[BoxData[GridBox[{{Cell[" ", "TableRowIcon"], 
       Cell[BoxData["RequireProof"], "TableText"], 
       Cell["False", "TableText"], Cell["False (default) or True: a result \
that is not Proven (numerical fits, verified reconstructions, sampled checks) \
fails with ProofRequired.", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["WorkingPrecision"], "TableText"], 
       Cell["40", "TableText"], 
       Cell["See the method choices in this page's details.", "TableText"]}, 
      {Cell[" ", "TableRowIcon"], Cell[BoxData["SeriesOrder"], "TableText"], 
       Cell["Automatic", "TableText"], Cell["Automatic (default: chosen from \
the accuracy goal and the point, or 6 orders for construction checks) or a \
positive integer; an explicit order is required to evaluate a finite jet (the \
result then has EstimatedError Missing[\"NoTailBound\"] or the next-order \
difference).", "TableText"]}, {Cell[" ", "TableRowIcon"], 
       Cell[BoxData["Verification"], "TableText"], Cell["Automatic", 
        "TableText"], Cell["Automatic, \"Exact\", \"Numerical\" or None (the \
Validate functions: Automatic, \"Exact\" or \"Numerical\"; the modular-form \
functions have no \"Exact\" route).", "TableText"]}}, 
     GridBoxAlignment -> {"Columns" -> {{Left}}}, GridBoxItemSize -> 
      {"Columns" -> {Scaled[0.02], Scaled[0.3], Scaled[0.18], 
         Scaled[0.5]}}]], "3ColumnTableMod"], 
  Cell["See Also", "SeeAlsoSection"], 
  Cell[TextData[{ButtonBox["ModularFormEvaluate", BaseStyle -> "Hyperlink", 
      ButtonData -> {"ModularFormEvaluate.nb", None}], "  |  ", 
     ButtonBox["RequireProof", BaseStyle -> "Hyperlink", 
      ButtonData -> {"RequireProof.nb", None}]}], "SeeAlso"], 
  Cell["Examples Initialization", "ExamplesInitializationSection"], 
  Cell["Open this notebook in its repository location. GAP must be installed; \
LINS is required for its bounded search page. Evaluate the setup before the \
examples.", "ExampleText"], 
  Cell[BoxData[RowBox[{RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{RowBox[{"Nest", "[", RowBox[{"DirectoryName", 
                  ",", RowBox[{"NotebookFileName", "[", "]"}], ",", "5"}], 
                "]"}], ",", "\"Kernel\"", ",", "\"init.m\""}], "}"}], "]"}], 
        "]"}], ";"}]], "ExampleInitialization"], 
  Cell["Basic Examples", "PrimaryExamplesSection"], 
  Cell[BoxData[RowBox[{"Module", "[", 
      RowBox[{RowBox[{"{", RowBox[{RowBox[{"g", "=", RowBox[{"BuildGroup", 
                "[", RowBox[{RowBox[{"GroupPresentation", "[", RowBox[
                     {RowBox[{"{", RowBox[{"\"s\"", ",", "\"t\""}], "}"}], 
                      ",", RowBox[{"{", RowBox[{"\"s^2\"", ",", "\"t^2\"", 
                          ",", "\"(s.t)^3\""}], "}"}]}], "]"}], ",", 
                  RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}]}], 
            ",", "d", ",", "one"}], "}"}], ",", 
        RowBox[{RowBox[{"AssignModularGenerators", "[", 
            RowBox[{"g", ",", RowBox[{"GroupWord", "[", "\"t^-1.s.t\"", 
                "]"}], ",", RowBox[{"GroupWord", "[", "\"s\"", "]"}], ",", 
              RowBox[{"StoreGAPState", "\[Rule]", "False"}]}], "]"}], ";", 
          RowBox[{"d", "=", RowBox[{"First", "[", RowBox[{"Select", "[", 
                RowBox[{RowBox[{"g", "[", "\"IrrepOrder\"", "]"}], ",", 
                  RowBox[{RowBox[{RowBox[{"RepDim", "[", RowBox[
                         {"GroupRepresentation", "[", RowBox[{"g", ",", 
                          "#1"}], "]"}], "]"}], "===", "2"}], "&"}]}], "]"}], 
              "]"}]}], ";", RowBox[{"one", "=", RowBox[
             {RowBox[{"g", "[", "\"CharacterData\"", "]"}], "[", 
              "\"TrivialIrrepID\"", "]"}]}], ";", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"y", "=", 
                  RowBox[{"First", "[", RowBox[{"ConstructModularForms", "[", 
                      RowBox[{"g", ",", "d"}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{RowBox[{"ModularFormGetCoeff", "[", RowBox[{"y", ",", 
                    RowBox[{"WorkingPrecision", "\[Rule]", "30"}]}], "]"}], 
                ";", RowBox[{RowBox[{"ValidateModularForm", "[", "y", "]"}], 
                  "[", "\"ProofStatus\"", "]"}]}]}], "]"}]}]}], "]"}]], 
   "Input", CellTags -> "VerifiedExample"], 
  Cell[BoxData["\"NumericalEvidence\""], "Output"], 
  Cell["Possible Issues", "ExampleSection"], Cell["Invalid input returns a \
structured Failure. Check FailureQ before using the result.", "ExampleText"], 
  Cell[BoxData[RowBox[{"FailureQ", "[", RowBox[{"ValidateModularForm", "[", 
        "5", "]"}], "]"}]], "Input", CellTags -> "VerifiedErrorExample"], 
  Cell[BoxData["True"], "Output"], Cell["Related Guides", 
   "MoreAboutSection"], 
  Cell[TextData[{ButtonBox["Constructing finite groups", 
      BaseStyle -> "Hyperlink", ButtonData -> 
       {"../../Tutorials/ConstructingFiniteGroups.nb", None}]}], 
   "MoreAbout"], Cell[CellGroupData[{Cell["Metadata", "MetadataSection"], 
     Cell["Symbol", "Categorization", CellLabel -> "Entity Type"], 
     Cell["VVMFTool", "Categorization", CellLabel -> "Paclet Name"], 
     Cell["VVMFTool`", "Categorization", CellLabel -> "Context"], 
     Cell["VVMFTool/ref/ValidateModularForm", "Categorization", 
      CellLabel -> "URI"]}, Closed]]}, 
 WindowTitle -> "ValidateModularForm \[LongDash] VVMFTool", 
 WindowSize -> {1000, 850}, TaggingRules -> <|"Paclet" -> "VVMFTool", 
   "Status" -> "Alpha"|>, StyleDefinitions -> FrontEnd`FileName[{"Wolfram"}, 
   "FunctionPageStylesExt.nb", CharacterEncoding -> "UTF-8"]]
