                    "\"Degrees\"", "]"}], ",", "2"}], "]"}], "]"}]}], ";", 
          RowBox[{"Length", "[", RowBox[{"TensorIrrepList", "[", 
              RowBox[{"g", ",", RowBox[{"{", RowBox[{"d", ",", "d", ",", 
