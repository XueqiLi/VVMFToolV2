# Title: Native unitarization and T diagonalization
# Summary: Invariant forms, square-root-free factorizations and T eigenbases in cyclotomic arithmetic,
# producing scaled native variants.
# Dependencies: Diagnostics (VVMF_Failure), Dependencies (VVMF_Guarded), Representations
# (VVMF_WordMatrix, VVMF_VerifyRep); package RepnDecomp for BSGSAverage (loaded on demand).
# Contracts: A scaled native variant is a pair (N, sigma): cyclotomic generator matrices N and positive
# real cyclotomic scales sigma with sigma[1] = 1. Its visible matrices are F = L N L^-1 with
# L = DiagonalMat(List(sigma, Sqrt)); F is unitary exactly when N^dagger S N = S for S = DiagonalMat(sigma),
# and F_T is diagonal exactly when N_T is. N is conjugate to a verified native variant W by a
# cyclotomic matrix C (N = C W C^-1), so N is itself a native representation.
# See also: GAP/Representations.g; Kernel/RepresentationBasis.wl (Wolfram counterparts);
# VVMFArch/implementation/step2Status.md (S2.4b).

# Bound on the image closure of GroupAverage: elements times matrix entries.
VVMF_GROUP_AVERAGE_ENTRY_LIMIT := 4000000;

# Summary: Conjugate transpose of a cyclotomic matrix.
# Parameters/defaults: m is a square cyclotomic matrix.
# Returns: TransposedMat(ComplexConjugate(m)).
# Effects: Pure.
# Failures: None.
# Example: VVMF_Adjoint([[E(4)]]) = [[-E(4)]].
# See also: VVMF_InvariantForm.
VVMF_Adjoint := m -> TransposedMat(ComplexConjugate(m));

# Summary: Enumerate the matrix group generated by generator images.
# Parameters/defaults: images, nonempty list of invertible d-by-d cyclotomic matrices; bound, the group order.
# Returns: Sorted list of the distinct element matrices, or InvalidRepresentation failure.
# Effects: Pure.
# Failures: More than bound elements (the images do not represent the group).
# Example: the permutation matrices of S3 generate six elements.
# Remarks: The image of a representation is a quotient of the group, so averaging over it gives the
# group average up to a positive factor.
# See also: VVMF_InvariantForm.
VVMF_ImageClosure := function(images, bound)
    local d, elements, queue, x, g, y;
    d := Length(images[1]);
    elements := [IdentityMat(d)];
    queue := [IdentityMat(d)];
    while queue <> [] do
        x := Remove(queue, 1);
        for g in images do
            y := x * g;
            if not y in elements then
                AddSet(elements, y);
                Add(queue, y);
                if Length(elements) > bound then
                    return VVMF_Failure("InvalidRepresentation", "The images generate more elements than the group order.");
                fi;
            fi;
        od;
    od;
    return elements;
end;

# Summary: Positive Hermitian invariant form of verified generator images.
# Parameters/defaults: state (finite group state); images, one matrix per recorded generator; d, the
# degree; method "BSGSAverage", "GroupAverage" or "Automatic" (BSGSAverage, then GroupAverage).
# Returns: rec(form := H, method := used method) with m^dagger H m = H on every image, or failure.
# Effects: BSGSAverage loads RepnDecomp.
# Failures: DependencyUnavailable (RepnDecomp missing, for an explicit BSGSAverage), ResourceLimit
# (GroupAverage too large), InvalidRepresentation, UnprovedIdentity (the form is not invariant).
# Example: permutation matrices give H = IdentityMat(d).
# Remarks: GroupAverage is H = sum over the image group of m^dagger m, positive definite because the
# identity contributes the identity matrix. BSGSAverage sums the Kronecker representation
# g -> rho(g) (x) conj(rho(g)) over a stabilizer chain (RepnDecomp's GroupSumBSGS) and applies it to vec(I):
# S = sum rho(g) rho(g)^dagger satisfies rho S rho^dagger = S, so H = S^-1 is invariant (plan: the
# native construction gives S; its inverse is H in this convention). Both forms are positive definite by
# construction; GAP arithmetic cannot order real cyclotomics, so the consumer checks the positivity of
# the resulting scales exactly.
# See also: VVMF_Unitarize; VVMF_TDiagonalize.
VVMF_InvariantForm := function(state, images, d, method)
    local methods, name, h, elements, hom, sum, used, result;
    if images = [] then return rec(form := IdentityMat(d), method := "Trivial"); fi;
    if method = "Automatic" then methods := ["BSGSAverage", "GroupAverage"]; else methods := [method]; fi;
    result := VVMF_Failure("InvalidMethod", "Unknown unitarization method.");
    for name in methods do
        h := fail;
        if name = "BSGSAverage" then
            if LoadPackage("RepnDecomp") <> true then
                result := VVMF_Failure("DependencyUnavailable", "BSGSAverage requires the RepnDecomp package.");
            else
                sum := VVMF_Guarded(function()
                    local s;
                    hom := GroupHomomorphismByImagesNC(state.group, Group(images), state.generators, images);
                    s := ValueGlobal("GroupSumBSGS")(state.group, function(g)
                        local m; m := ImagesRepresentative(hom, g); return KroneckerProduct(m, ComplexConjugate(m)); end);
                    return List([1..d], i -> (s * Flat(IdentityMat(d))){[(i - 1) * d + 1..i * d]});
                end);
                if sum.ok then h := Inverse(sum.value); else result := VVMF_Failure(sum.tag, sum.message); fi;
            fi;
        elif name = "GroupAverage" then
            if Size(state.group) * d^2 > VVMF_GROUP_AVERAGE_ENTRY_LIMIT then
                result := VVMF_Failure("ResourceLimit", "The group is too large for a group average.");
            else
                elements := VVMF_ImageClosure(images, Size(state.group));
                if VVMF_IsFailure(elements) then result := elements;
                else h := Sum(elements, m -> VVMF_Adjoint(m) * m); fi;
            fi;
        fi;
        if h <> fail then
            if h = VVMF_Adjoint(h) and ForAll(images, m -> VVMF_Adjoint(m) * h * m = h) then
                return rec(form := h, method := name);
            fi;
            result := VVMF_Failure("UnprovedIdentity", "The computed form is not an invariant Hermitian form.");
        fi;
    od;
    return result;
end;

# Summary: LDL-adjoint factorization H = L D L^dagger without square roots.
# Parameters/defaults: h, a Hermitian cyclotomic matrix with nonzero leading principal minors.
# Returns: rec(l := unit lower-triangular matrix, diag := list of real cyclotomics), or failure.
# Effects: Pure.
# Failures: UnprovedIdentity for a zero or nonreal pivot.
# Example: VVMF_LDL([[2,1],[1,2]]) = rec(l := [[1,0],[1/2,1]], diag := [2,3/2]).
# Remarks: For a positive definite H every pivot is positive; positivity is checked by the consumer.
# See also: VVMF_Unitarize.
VVMF_LDL := function(h)
    local d, l, diag, i, j, s;
    d := Length(h);
    l := List(IdentityMat(d), ShallowCopy);
    diag := [];
    for j in [1..d] do
        s := h[j][j] - Sum([1..j - 1], k -> l[j][k] * ComplexConjugate(l[j][k]) * diag[k], 0);
        if s = 0 or ComplexConjugate(s) <> s then
            return VVMF_Failure("UnprovedIdentity", "A pivot of the LDL factorization is zero or not real.");
        fi;
        diag[j] := s;
        for i in [j + 1..d] do
            l[i][j] := (h[i][j] - Sum([1..j - 1], k -> l[i][k] * ComplexConjugate(l[j][k]) * diag[k], 0)) / s;
        od;
    od;
    return rec(l := l, diag := diag);
end;

# Summary: Check that a scaled variant (N, sigma) has unitary visible matrices.
# Parameters/defaults: images N; scales sigma (list of real cyclotomics) or fail for trivial scales.
# Returns: Boolean.
# Effects: Pure.
# Failures: None.
# Example: VVMF_ScaledUnitaryQ([[[0,1],[1,0]]], fail) = true.
# Remarks: F = L N L^-1 with L^2 = S = DiagonalMat(sigma); F^dagger F = I exactly when N^dagger S N = S.
# See also: VVMF_RepProperties.
VVMF_ScaledUnitaryQ := function(images, scales)
    local s;
    if scales = fail then
        return ForAll(images, m -> m * VVMF_Adjoint(m) = IdentityMat(Length(m)));
    fi;
    s := DiagonalMat(scales);
    return ForAll(images, m -> VVMF_Adjoint(m) * s * m = s);
end;

# Summary: Normalize a transform result: scales divided by the first, trivial scales dropped.
# Parameters/defaults: result rec(images, scales, conjugator).
# Returns: The same record with scales[1] = 1, or scales = fail when all scales are equal.
# Effects: Pure (returns a new record).
# Failures: None.
# Example: scales [2,2] become fail.
# Remarks: Scaling sigma by a constant does not change F.
# See also: VVMF_Unitarize; VVMF_TDiagonalize.
VVMF_NormalizeScales := function(result)
    local scales;
    scales := result.scales / result.scales[1];
    if ForAll(scales, x -> x = 1) then scales := fail; fi;
    return rec(images := result.images, scales := scales, conjugator := result.conjugator);
end;

# Summary: Unitarize verified images: N = C W C^-1 with C = L^dagger from H = L D L^dagger, sigma = D.
# Parameters/defaults: state; images W; d; method for VVMF_InvariantForm; form, a known invariant
# positive form of W, or fail to compute one.
# Returns: rec(images := N, scales := sigma or fail, conjugator := C, form := H, formMethod), or failure.
# Effects: May load RepnDecomp.
# Failures: Invariant-form and LDL failures; UnprovedIdentity when N^dagger S N = S does not hold.
# Example: a general S3 standard representation becomes a scaled unitary variant.
# Remarks: The upper Cholesky factor is B = sqrt(D) L^dagger, so B W B^-1 = sqrt(D) N sqrt(D)^-1 is unitary
# exactly when N^dagger D N = D. No square roots are taken here.
# See also: VVMF_InvariantForm; VVMF_LDL; VVMF_NormalizeScales.
VVMF_Unitarize := function(state, images, d, method, form)
    local invariant, ldl, c, n;
    if form = fail then
        invariant := VVMF_InvariantForm(state, images, d, method);
        if VVMF_IsFailure(invariant) then return invariant; fi;
    else invariant := rec(form := form, method := "Supplied"); fi;
    ldl := VVMF_LDL(invariant.form);
    if VVMF_IsFailure(ldl) then return ldl; fi;
    c := VVMF_Adjoint(ldl.l);
    n := List(images, w -> c * w * c^-1);
    if not VVMF_ScaledUnitaryQ(n, ldl.diag) then
        return VVMF_Failure("UnprovedIdentity", "The unitarized matrices are not unitary.");
    fi;
    n := VVMF_NormalizeScales(rec(images := n, scales := ldl.diag, conjugator := c));
    n.form := invariant.form; n.formMethod := invariant.method;
    return n;
end;

# Summary: Diagonalize the assigned T in an invariant inner product: a unitary T-diagonal scaled variant.
# Parameters/defaults: state with a modular assignment; images W; d; form H, a positive invariant form of
# W; options rec(phaseOrder := "Ascending" or "Unchanged", phaseConvention := "None" or "FirstSRow").
# Returns: rec(images := N, scales, conjugator := C, labels, order) with N_T diagonal and N^dagger S N = S,
# or failure.
# Effects: Pure.
# Failures: MissingModularAssignment; UnprovedIdentity when the eigenspaces do not span or an identity
# fails.
# Example: for S3 with T of order two the new T is DiagonalMat([1,-1]).
# Remarks: Eigenvectors of T for E(n)^k (n the order of T) are orthogonalized without normalization in
# u^dagger H v; with columns Q, K = Q^-1 W Q and G = Q^dagger H Q diagonal. Visible matrices are
# G^(1/2) K G^(-1/2); FirstSRow multiplies by the diagonal unitary with phases c_j/|c_j|, c_j the
# nonzero first-row entries of K_S (c_1 = 1). With D = DiagonalMat(c): N = D K D^-1, C = D Q^-1 and
# sigma_j = g_j/(c_j conj(c_j)). All of it is cyclotomic.
# See also: VVMF_Unitarize; Kernel/RepresentationBasis.wl exactDiagonalization.
VVMF_TDiagonalize := function(state, images, d, form, options)
    local t, n, spaces, k, vectors, basis, u, v, w, labels, order, q, qi, kmats, kt, g, c, ks, j, dmat, result;
    if not IsBound(state.modularAssignment) then
        return VVMF_Failure("MissingModularAssignment", "T diagonalization requires a modular S,T assignment.");
    fi;
    t := VVMF_WordMatrix(state, images, state.modularAssignment.tWord, d);
    if VVMF_IsFailure(t) then return t; fi;
    n := Order(t);
    spaces := [];
    for k in [0..n - 1] do
        vectors := NullspaceMat(TransposedMat(t - E(n)^k * IdentityMat(d)));
        if vectors <> [] then
            # Orthogonalize in the invariant inner product u^dagger H v, without normalization.
            basis := [];
            for v in vectors do
                w := v - Sum(basis, u -> ((ComplexConjugate(u) * form * v) / (ComplexConjugate(u) * form * u)) * u, 0 * v);
                Add(basis, w);
            od;
            Add(spaces, [k, basis]);
        fi;
    od;
    if Sum(spaces, s -> Length(s[2]), 0) <> d then
        return VVMF_Failure("UnprovedIdentity", "The eigenspaces of T do not span the representation space.");
    fi;
    vectors := Concatenation(List(spaces, s -> s[2]));
    labels := Concatenation(List(spaces, s -> List(s[2], x -> s[1])));
    if options.phaseOrder = "Unchanged" then
        order := SortingPerm(List([1..d], i -> [PositionProperty(vectors[i], x -> x <> 0), i]));
        vectors := Permuted(vectors, order); labels := Permuted(labels, order);
    fi;
    q := TransposedMat(vectors); qi := q^-1;
    kmats := List(images, m -> qi * m * q);
    kt := VVMF_WordMatrix(state, kmats, state.modularAssignment.tWord, d);
    g := VVMF_Adjoint(q) * form * q;
    if not IsDiagonalMat(kt) or not IsDiagonalMat(g) then
        return VVMF_Failure("UnprovedIdentity", "The eigenbasis does not diagonalize T orthogonally.");
    fi;
    c := List([1..d], i -> 1);
    if options.phaseConvention = "FirstSRow" then
        ks := VVMF_WordMatrix(state, kmats, state.modularAssignment.sWord, d);
        for j in [2..d] do if ks[1][j] <> 0 then c[j] := ks[1][j]; fi; od;
    fi;
    dmat := DiagonalMat(c);
    result := rec(images := List(kmats, m -> dmat * m * dmat^-1),
        scales := List([1..d], i -> g[i][i] / (c[i] * ComplexConjugate(c[i]))), conjugator := dmat * qi);
    if not VVMF_ScaledUnitaryQ(result.images, result.scales) or
        not IsDiagonalMat(VVMF_WordMatrix(state, result.images, state.modularAssignment.tWord, d)) then
        return VVMF_Failure("UnprovedIdentity", "The T-diagonal matrices are not unitary.");
    fi;
    result := VVMF_NormalizeScales(result);
    result.labels := labels; result.order := n;
    return result;
end;

# Summary: Choose the variant of an irrep with the smallest cyclotomic conductor.
# Parameters/defaults: state; irrepID; filter, a predicate on variant records (fail for any).
# Returns: The variant name, or fail when no variant passes the filter.
# Effects: Pure.
# Failures: None.
# Example: of a unitary Dixon variant (conductor 1320) and a general Dixon variant (conductor 15) of
# A5, the general one is chosen.
# Remarks: The conductor of the witness governs the size of every derived number, so transforms start
# from the smallest field (ties: the active variant, then name order).
# See also: VVMF_Representations (Unitarize, TDiagonalize).
VVMF_WitnessVariant := function(state, irrepID, filter)
    return ValueGlobal("VVMF_WitnessVariantMode")(state, irrepID, filter, "Automatic");
end;

# Summary: The witness variant of an irrep under an explicit choice (methodOptionsPlan.md 2B.2).
# Parameters/defaults: state; irrepID; filter as VVMF_WitnessVariant; mode "Automatic" or "SmallestConductor"
# (smallest conductor, ties the active variant then name order) or "Active" (the active variant only).
# Returns: A variant name, or fail (for "Active": the active variant is inert or fails the filter; no other variant
# replaces it).
# Effects: Pure.
# Failures: None.
VVMF_WitnessVariantMode := function(state, irrepID, filter, mode)
    local entry, names, key;
    if mode = "Active" then
        if not IsBound(state.representations) or not IsBound(state.representations.(irrepID)) then return fail; fi;
        entry := state.representations.(irrepID);
        # an irrep holding only an accepted partial has activeVariant = fail: no active witness
        if not IsBound(entry.activeVariant) or not IsString(entry.activeVariant) or not IsBound(entry.variants.(entry.activeVariant)) or
            ValueGlobal("VVMF_InertVariantQ")(entry.variants.(entry.activeVariant)) or
            (filter <> fail and not filter(entry.variants.(entry.activeVariant))) then
            return fail;
        fi;
        return entry.activeVariant;
    fi;
    if not IsBound(state.representations) or not IsBound(state.representations.(irrepID)) then return fail; fi;
    entry := state.representations.(irrepID);
    # Inert variants have no cyclotomic images and never serve as witnesses.
    names := Filtered(RecNames(entry.variants), name -> not ValueGlobal("VVMF_InertVariantQ")(entry.variants.(name)) and
        (filter = fail or filter(entry.variants.(name))));
    if names = [] then return fail; fi;
    key := name -> [Conductor(Flat(entry.variants.(name).images)), name <> entry.activeVariant, name];
    return names[Position(List(names, key), Minimum(List(names, key)))];
end;

# Summary: Decode a matrix of request scalars (integer, rational or cyclotomic records).
# Parameters/defaults: matrix, rows of VVMF_EncodeScalar records.
# Returns: The cyclotomic matrix, or InvalidRequest failure.
# Effects: Pure.
# Failures: Malformed rows or entries.
# Example: VVMF_DecodeRequestMatrix([[VVMF_EncodeScalar(2)]]) = [[2]].
# Remarks: Request data come from the coordinator; everything derived from them is verified here.
# See also: VVMF_Decompose.
VVMF_DecodeRequestMatrix := function(matrix)
    local decoded;
    if not IsList(matrix) or not ForAll(matrix, IsList) then return VVMF_Failure("InvalidRequest", "Invalid matrix."); fi;
    decoded := List(matrix, row -> List(row, VVMF_DecodeScalar));
    if ForAny(Flat(decoded), VVMF_IsFailure) then return VVMF_Failure("InvalidRequest", "Invalid matrix entry."); fi;
    return decoded;
end;

# Summary: Intertwiners from a target irrep into a (restricted) representation: R Y = Y N.
# Parameters/defaults: state; r, the representation's matrices on the recorded generators (k by k);
# n, the target's matrices (e by e); multiplicity m; method "GeneratorEquations", "BSGS", "GroupAverage"
# or "OrbitSum".
# Returns: List of m matrices Y (k by e) with r_i Y = Y n_i for every generator, or failure.
# Effects: BSGS, GroupAverage and OrbitSum load RepnDecomp.
# Failures: InapplicableMethod (a RepnDecomp alignment on a space that is not one copy of the target);
# UnprovedIdentity (wrong null-space dimension or a failed check).
# Example: aligning a permuted copy of an irrep to the irrep gives the permutation.
# Remarks: GeneratorEquations: row-major vec(R Y - Y N) = (R kron I - I kron N^T) vec(Y); the right null space
# is NullspaceMat of the transpose. RepnDecomp's LinearRepresentationIsomorphism(rho1, tau1) returns A with
# tau1(g) A = A rho1(g); called with (target, representation) it gives R A = A N, so Y = A. BSGS uses its
# use_kronecker option (GroupSumBSGS over a stabilizer chain), OrbitSum its use_orbit_sum option and
# GroupAverage the default projection summed over the group.
# See also: VVMF_Decompose.
VVMF_AlignIntertwiners := function(state, r, n, m, method)
    local k, e, system, null, ys, tau, rho, a;
    k := Length(r[1]); e := Length(n[1]);
    if method = "GeneratorEquations" then
        system := Concatenation(List([1..Length(r)], i -> KroneckerProduct(r[i], IdentityMat(e)) -
            KroneckerProduct(IdentityMat(k), TransposedMat(n[i]))));
        null := NullspaceMat(TransposedMat(system));
        if Length(null) <> m then
            return VVMF_Failure("UnprovedIdentity", "The intertwiner space does not have the character multiplicity.");
        fi;
        ys := List(null, v -> List([1..k], row -> v{[(row - 1) * e + 1..row * e]}));
    else
        if m <> 1 or k <> e then
            return VVMF_Failure("InapplicableMethod", "RepnDecomp alignment needs one copy of the target.");
        fi;
        if LoadPackage("RepnDecomp") <> true then
            return VVMF_Failure("DependencyUnavailable", "RepnDecomp is required for this alignment.");
        fi;
        tau := GroupHomomorphismByImagesNC(state.group, Group(n), state.generators, n);
        rho := GroupHomomorphismByImagesNC(state.group, Group(r), state.generators, r);
        # LinearRepresentationIsomorphism(tau, rho) returns A with rho(g) A = A tau(g), that is R A = A N.
        if method = "BSGS" then a := ValueGlobal("LinearRepresentationIsomorphism")(tau, rho : use_kronecker);
        elif method = "OrbitSum" then a := ValueGlobal("LinearRepresentationIsomorphism")(tau, rho : use_orbit_sum);
        else a := ValueGlobal("LinearRepresentationIsomorphism")(tau, rho); fi;
        if a = fail then return VVMF_Failure("UnprovedIdentity", "No isomorphism to the target was found."); fi;
        ys := [a];
    fi;
    if not ForAll(ys, y -> ForAll([1..Length(r)], i -> r[i] * y = y * n[i])) then
        return VVMF_Failure("UnprovedIdentity", "An aligned intertwiner does not verify.");
    fi;
    return ys;
end;

# Summary: Native decomposition of a representation into stored or supplied target irreps.
# Parameters/defaults: state; request.decomposition = rec(matrices (one request-scalar matrix per recorded
# generator), targets := rec(irrepID -> rec(variant := name) or rec(matrices := request-scalar matrices)),
# multiplicities := rec(irrepID -> decimal string), method "Serre", "Alternative", "Canonical",
# "REPSNConstituents" or "REPSNBlocks", alignment "Automatic", "BSGS", "GroupAverage", "OrbitSum" or
# "GeneratorEquations").
# Returns: rec(method, alignment, solutions := rec(irrepID -> list of VVMF_EncodeRepScalar matrices X
# (d by target degree) with M_i X = X N_i)), or failure.
# Effects: Loads RepnDecomp or REPSN on demand; stores nothing in the state.
# Failures: InvalidRequest; InvalidRepresentation (the input fails the relators, a supplied target fails
# VVMF_VerifyRep); DependencyUnavailable; InapplicableMethod; UnprovedIdentity (a subspace or intertwiner
# that does not verify; REPSN multiplicities that disagree).
# Example: the natural permutation representation of S4 decomposes into the trivial and a degree-three
# target by Serre's formula.
# Remarks: Serre/Alternative pass the targets as RepnDecomp's irreps option; the returned subspace bases,
# transposed, already satisfy M X = X N. Canonical gives isotypic subspaces (columns B, M B = B R); their
# intertwiners Y (R Y = Y N) give X = B Y. REPSN computes the constituents (multiplicities are checked
# against the request) and the intertwiners are aligned on the whole space. Automatic alignment tries BSGS,
# GroupAverage and OrbitSum where they apply (one copy on an irreducible space), then GeneratorEquations.
# See also: VVMF_AlignIntertwiners; Kernel/RepresentationDecomposition.wl generatorDecomposition.
VVMF_Decompose := function(state, request)
    local spec, images, d, relators, rho, ids, targets, id, t, taus, method, alignment, solutions, spaces,
        index, align, basis, restricted, ys, constituents, entry, dec, used;
    if not IsBound(request.decomposition) or not IsRecord(request.decomposition) then
        return VVMF_Failure("InvalidRequest", "A decomposition request is required.");
    fi;
    spec := request.decomposition;
    if not IsBound(spec.matrices) or not IsBound(spec.targets) or not IsBound(spec.multiplicities) or
        not IsBound(spec.method) or not IsBound(spec.alignment) or
        not spec.method in ["Serre", "SerreKronecker", "Alternative", "Canonical", "REPSNConstituents", "REPSNBlocks"] or
        not spec.alignment in ["Automatic", "BSGS", "GroupAverage", "OrbitSum", "GeneratorEquations"] or
        Length(spec.matrices) <> Length(state.generators) or Length(state.generators) = 0 then
        return VVMF_Failure("InvalidRequest", "Malformed decomposition request.");
    fi;
    images := List(spec.matrices, VVMF_DecodeRequestMatrix);
    if ForAny(images, VVMF_IsFailure) then return First(images, VVMF_IsFailure); fi;
    d := Length(images[1]);
    relators := VVMF_RepRelators(state);
    if relators = fail or ForAny(relators, letters -> VVMF_LetterMatrix(images, letters, d) <> IdentityMat(d)) then
        return VVMF_Failure("InvalidRepresentation", "The input does not satisfy the group's relators.");
    fi;
    ids := RecNames(spec.targets);
    targets := rec();
    for id in ids do
        t := spec.targets.(id);
        if IsBound(t.variant) then
            if not IsBound(state.representations) or not IsBound(state.representations.(id)) or
                not IsBound(state.representations.(id).variants.(t.variant)) then
                return VVMF_Failure("InvalidRequest", "A named target variant is not stored.");
            fi;
            if ValueGlobal("VVMF_InertVariantQ")(state.representations.(id).variants.(t.variant)) then
                return VVMF_Failure("InapplicableMethod", "Native decomposition needs cyclotomic target variants.");
            fi;
            targets.(id) := state.representations.(id).variants.(t.variant).images;
        else
            targets.(id) := List(t.matrices, VVMF_DecodeRequestMatrix);
            if ForAny(targets.(id), VVMF_IsFailure) or VVMF_IsFailure(VVMF_VerifyRep(state, id, targets.(id))) then
                return VVMF_Failure("InvalidRepresentation", "A supplied target is not a verified irrep.");
            fi;
        fi;
    od;
    method := spec.method;
    align := function(r, n, m)
        local order, name, result;
        if spec.alignment = "Automatic" then order := ["BSGS", "GroupAverage", "OrbitSum", "GeneratorEquations"];
        else order := [spec.alignment]; fi;
        result := VVMF_Failure("InapplicableMethod", "No alignment applies.");
        for name in order do
            result := VVMF_AlignIntertwiners(state, r, n, m, name);
            if not VVMF_IsFailure(result) then used := name; return result; fi;
            if spec.alignment <> "Automatic" then return result; fi;
        od;
        return result;
    end;
    used := "None";
    solutions := rec();
    rho := GroupHomomorphismByImagesNC(state.group, Group(images), state.generators, images);
    if method in ["Serre", "SerreKronecker", "Alternative", "Canonical"] then
        if LoadPackage("RepnDecomp") <> true then
            return VVMF_Failure("DependencyUnavailable", "RepnDecomp is required for this decomposition.");
        fi;
        taus := List(ids, id -> GroupHomomorphismByImagesNC(state.group, Group(targets.(id)), state.generators, targets.(id)));
        if method = "Canonical" then
            spaces := ValueGlobal("CanonicalDecomposition")(rho : irreps := taus);
        elif method = "Serre" then
            dec := ValueGlobal("REPN_ComputeUsingSerre")(rho : irreps := taus);
        elif method = "SerreKronecker" then
            # Stage 4 SerreBSGS: RepnDecomp's Kronecker (stabilizer-chain) projections.
            dec := ValueGlobal("REPN_ComputeUsingSerre")(rho : irreps := taus, use_kronecker := true);
        else
            dec := ValueGlobal("REPN_ComputeUsingMyMethod")(rho : irreps := taus);
        fi;
        for index in [1..Length(ids)] do
            id := ids[index];
            if method = "Canonical" then
                basis := Basis(spaces[index]);
                if Length(basis) <> Int(spec.multiplicities.(id)) * Length(targets.(id)[1]) then
                    return VVMF_Failure("UnprovedIdentity", "An isotypic subspace does not have the character dimension.");
                fi;
                basis := TransposedMat(List(basis));
                # Restricted matrices: M B = B R.
                restricted := List(images, m -> TransposedMat(List(TransposedMat(m * basis), v -> SolutionMat(TransposedMat(basis), v))));
                if ForAny(restricted, r -> fail in r) or ForAny([1..Length(images)], i -> images[i] * basis <> basis * restricted[i]) then
                    return VVMF_Failure("UnprovedIdentity", "An isotypic subspace is not invariant.");
                fi;
                ys := align(restricted, targets.(id), Int(spec.multiplicities.(id)));
                if VVMF_IsFailure(ys) then return ys; fi;
                solutions.(id) := List(ys, y -> basis * y);
            else
                entry := dec.decomposition[index];
                if Length(entry) <> Int(spec.multiplicities.(id)) then
                    return VVMF_Failure("UnprovedIdentity", "The decomposition does not have the character multiplicity.");
                fi;
                solutions.(id) := [];
                for basis in entry do
                    # Serre returns records whose transposed basis already intertwines with the target; other
                    # subspaces (vector spaces) are aligned through their restricted matrices.
                    if IsRecord(basis) then basis := TransposedMat(basis.basis);
                    else basis := TransposedMat(List(Basis(basis))); fi;
                    if ForAll([1..Length(images)], i -> images[i] * basis = basis * targets.(id)[i]) then
                        Add(solutions.(id), basis);
                        if used = "None" then used := "Supplied irreps"; fi;
                    else
                        restricted := List(images, m -> TransposedMat(List(TransposedMat(m * basis), v -> SolutionMat(TransposedMat(basis), v))));
                        if ForAny(restricted, r -> fail in r) then
                            return VVMF_Failure("UnprovedIdentity", "An irreducible subspace is not invariant.");
                        fi;
                        ys := align(restricted, targets.(id), 1);
                        if VVMF_IsFailure(ys) then return ys; fi;
                        Add(solutions.(id), basis * ys[1]);
                    fi;
                od;
            fi;
        od;
    else
        if LoadPackage("repsn") <> true then
            return VVMF_Failure("DependencyUnavailable", "REPSN is required for this decomposition.");
        fi;
        constituents := ValueGlobal("ConstituentsOfRepresentation")(rho);
        if method = "REPSNBlocks" then ValueGlobal("EquivalentBlockRepresentation")(constituents); fi;
        if SortedList(List(constituents, c -> c[1])) <> SortedList(List(ids, id -> Int(spec.multiplicities.(id)))) or
            Sum(constituents, c -> c[1] * Length(ImagesRepresentative(c[2], One(Source(c[2]))))) <> d then
            return VVMF_Failure("UnprovedIdentity", "The REPSN constituents disagree with the multiplicities.");
        fi;
        for id in ids do
            ys := align(images, targets.(id), Int(spec.multiplicities.(id)));
            if VVMF_IsFailure(ys) then return ys; fi;
            solutions.(id) := ys;
        od;
    fi;
    # Every returned intertwiner is checked on the input: M_i X = X N_i.
    for id in ids do
        if not ForAll(solutions.(id), x -> ForAll([1..Length(images)], i -> images[i] * x = x * targets.(id)[i])) then
            return VVMF_Failure("UnprovedIdentity", "A decomposition basis does not intertwine the input and its target.");
        fi;
        solutions.(id) := List(solutions.(id), x -> List(x, row -> List(row, VVMF_EncodeRepScalar)));
    od;
    return rec(method := method, alignment := used, solutions := solutions);
end;
