   CellLabel -> "Out[14]="], Cell["VectorComponents[CGPolynomialResult[GroupT\
p, {4, 7}, 6, ComponentLists -> {{a1, a2}, {b1, b2, b3}}]][[All, \
\"Components\"]] // Simplify", "Input", CellLabel -> "In[15]:="], 
  Cell[BoxData[RowBox[
     {"{", RowBox[{"{", RowBox[{FractionBox[RowBox[
            {RowBox[{SqrtBox["2"], " ", "a2", " ", "b1"}], "+", 
             RowBox[{"a1", " ", "b2"}]}], SqrtBox["3"]], ",", 
          FractionBox[RowBox[{RowBox[{"a2", " ", "b2"}], "+", 
             RowBox[{SqrtBox["2"], " ", "a1", " ", "b3"}]}], SqrtBox["3"]]}], 
        "}"}], "}"}]], "Output", CellLabel -> "Out[15]="], 
  Cell["A product in detail, as in the VVMFUse Inspector: the decomposition, \
the embedding of each copy of a target into the product space (column k is \
the k-th target basis vector; row (i-1) dim(q) + j is the coefficient of a_i \
b_j), and the polynomial form. The products are chosen here, all of at least \
2-dimensional irreps.", "Text"], Cell["showProduct[g_, {p_, q_}] := \
Module[{name, dec = TensorDecomposition[g, {p, q}], cg = CGCoefficients[g, \
{p, q}, All], dp, dq},\n    name[k_] := Replace[IrrepLabel[g, k, \
\"Display\"], _Missing :> ToString[k]];\n    dp = \
RepDim[GroupRepresentation[g, p]]; dq = RepDim[GroupRepresentation[g, q]];\n  \
  Column[{\n        Style[Row[{name[p], \" \\[CircleTimes] \", name[q], \"  = \
 \", Row[Riffle[Row[{If[dec[#] > 1, ToString[dec[#]] <> \"\\[CenterDot]\", \
\"\"], name[#]}] & /@ Keys[dec], \" \\[CirclePlus] \"]]}], \"Subsection\"],\n \
       Row[{\"ValidateCG: \", ValidateCG[cg][\"Valid\"]}],\n        \
Column[Table[OpenerView[{Row[{\"CG coefficients into \", name[t], \"  (\", \
dec[t], If[dec[t] > 1, \" copies)\", \" copy)\"]}],\n            \
Column[Table[Labeled[MatrixForm[ch[\"Embedding\"]], Row[{\"copy \", \
ch[\"Copy\"], \" (\", ch[\"Symmetry\"], \")\"}], Top], {ch, \
CGIntertwiners[cg, t]}]]}], {t, Keys[dec]}]],\n        \
OpenerView[{Row[{\"Polynomial form: components a_i of \", name[p], \", b_j of \
\", name[q]}],\n            Column[Table[Row[{name[t], \":  \", \
Row[MatrixForm /@ Lookup[VectorComponents[CGPolynomialResult[g, {p, q}, t,\n  \
              ComponentLists -> {Array[Subscript[a, #] &, dp], \
Array[Subscript[b, #] &, dq]}]], \"Components\"], \"   \"]}], {t, \
Keys[dec]}]]}]\n    }, Spacings -> 1]];", "Input", CellLabel -> "In[16]:="], 
  Cell["showProduct[GroupTp, {4, 5}]", "Input", CellLabel -> "In[17]:="], 
  Cell[BoxData[TagBox[GridBox[
      {{StyleBox[TemplateBox[{InterpretationBox[StyleBox["\"2\"", Bold, 
             StripOnInput -> False], "2"], "\" \[CircleTimes] \"", 
           InterpretationBox[TemplateBox[{StyleBox["\"2\"", Bold, 
               StripOnInput -> False], "\"\[Prime]\""}, "Superscript", 
             SyntaxForm -> SuperscriptBox], "2'"], "\"  =  \"", 
           TemplateBox[{TemplateBox[{"\"\"", InterpretationBox[StyleBox[
                 "\"1\"", Bold, StripOnInput -> False], "1"]}, "RowDefault"], 
             "\" \[CirclePlus] \"", TemplateBox[{"\"\"", InterpretationBox[
                StyleBox["\"3\"", Bold, StripOnInput -> False], "3"]}, 
              "RowDefault"]}, "RowDefault"]}, "RowDefault"], "Subsection", 
         StripOnInput -> False]}, {TemplateBox[{"\"ValidateCG: \"", "True"}, 
         "RowDefault"]}, 
