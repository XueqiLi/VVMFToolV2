Notebook[{Cell["VVMFTool v2 Library", "Title"], 
  Cell["VVMFToolv2 ships a library of the groups computed in the VVMFUse \
project: their irreps in the paper's basis, the S and T assignment, the \
Clebsch-Gordan coefficients and the paper's names of the irreps and classes. \
LoadGroup loads a group from it in a moment, without GAP.", "Text"], 
  Cell["Load the package", "Section"], Cell["Load VVMFToolv2 through the link \
VVMFToolv2 next to this notebook (it points to \
25.03.00.General/software/VVMFToolv2). Loading does not start GAP.", "Text"], 
  Cell["$VVMFToolV2Root = FileNameJoin[{NotebookDirectory[], \
\"VVMFToolv2\"}];\nGet[FileNameJoin[{$VVMFToolV2Root, \"Kernel\", \
\"init.m\"}]]", "Input", CellLabel -> "In[1]:="], 
  Cell[BoxData["True"], "Output", CellLabel -> "Out[1]="], 
  Cell["Load the group", "Section"], Cell["LibraryGroups lists the groups of \
the library with their status (complete, or complete except a few slow CG \
pairs, or partial).", "Text"], Cell["LibraryGroups[]", "Input", 
   CellLabel -> "In[2]:="], 
