Notebook[{

Cell[CellGroupData[{
Cell["VVMF handbook: compute and export", "Title",ExpressionUUID->"8a31ea83-852e-45c8-b211-3af1a1e857c2"],

Cell["\<\
Change qOrder only, then choose Evaluation > Evaluate Notebook. Keep \
VVMF_Engine.wl next to this notebook. The complete exact catalogue is \
computed and saved as VVMF_Results_Data.wl in this folder. The output file is \
overwritten by the new order.\
\>", "Text",ExpressionUUID->"c4930872-1310-4748-8a44-c6ffa658fbde"],

