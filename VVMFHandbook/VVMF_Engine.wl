(* VVMF engine, revision 6. This is the only input dependency of
   VVMF_Compute.nb. It contains code and finite initial data, no answer arrays.
   The notebook exposes only qOrder; every path and option is fixed. *)
$IterationLimit=Max[$IterationLimit,1000000];
Clear[q,VVMFTheta,VVMFAlpha2];
$VVMFMaxOrder=20;
$VVMFMode="Compute";
(* VVMF handbook: readable computational core, revision 4.
   Load VVMF_Compute.wl or VVMF_Results.wl to install the catalogue first.
   This file contains code only. Tables are separate plain-text .wl files.
   Every coefficient operation uses exact integers/rationals/field elements.
*)

(* Exact q-series routines. No network access or external packages. *)
ClearAll[VVMFKMul,VVMFKInverse,VVMFMultiplicationMatrix,VVMFConv, VVMFEisenstein,VVMFMonomial,VVMFEta,
  VVMFModelSeries,VVMFRootSelect, VVMFPolynomialValue,VVMFParameters,VVMFGet,VVMFResolve,VVMFList,
  VVMFQExpansion,VVMFCoefficient,VVMFComputeAll,VVMFLaTeX, VVMFSerreDerivative,VVMFScalarMultiply,
  VVMFSeriesFromData,VVMFValidateSeeds,VVMFKeyTake,VVMFFailureQ];
(* 1. Exact coefficient fields.
 A field element is {a0,...,a(d-1)}, representing Sum[a_j theta^j].
 mod lists the coefficients of the polynomial of theta in ascending order.
 Multiplication is ordinary convolution followed by polynomial reduction. *)
VVMFKMul[a_List,b_List,mod_List] := Module[{d=Length[a],p,c,n,j}, If[d==1,Return[{a[[1]] b[[1]]}]];
  p=Table[Sum[a[[i+1]] b[[n-i+1]],{i,Max[0,n-d+1],Min[n,d-1]}],{n,0,2d-2}];
  Do[c=p[[n+1]];
    If[c!=0,Do[p[[n-d+j+1]]=p[[n-d+j+1]]-c mod[[j+1]]/Last[mod],{j,0,d-1}]],{n,2d-2,d,-1}];
  Take[p,d] ];
VVMFMultiplicationMatrix[a_List,mod_List] := Transpose[Table[ VVMFKMul[a,UnitVector[Length[a],j],
      mod],{j,Length[a]}]];
VVMFKInverse[a_List,mod_List] := VVMFKInverse[a,mod] =
If[Length[a]==1,{1/a[[1]]},LinearSolve[VVMFMultiplicationMatrix[a,mod],UnitVector[Length[a],1]]];
(* 2. Scalar q-series.
 List element m+1 is the coefficient of q^m. Convolution is truncated at n.
 E2, E4 and E6 have their standard normalizations.
 VVMFEta[k,n] returns the integer-power part of eta^(2 k). *)
VVMFConv[a_List,b_List,n_Integer] := Table[ Sum[a[[i+1]] b[[m-i+1]],{i,Max[0,m-Length[b]+1],Min[m,
        Length[a]-1]}],{m,0,n}];
VVMFEisenstein[k_Integer,n_Integer] := VVMFEisenstein[k,n] =
Prepend[Table[Switch[k,2,-24,4,240,6,-504] DivisorSigma[k-1,m],{m,1,n}],1];
VVMFMonomial[a_Integer,b_Integer,n_Integer] := VVMFMonomial[a,b,n] = Module[{z=UnitVector[n+1,1]},
  Do[z=VVMFConv[z,VVMFEisenstein[4,n],n],{a}];
  Do[z=VVMFConv[z,VVMFEisenstein[6,n],n],{b}];
  z];
VVMFEta[k_Integer,n_Integer] := Module[{a=ConstantArray[0,n+1]},a[[1]]=1;
  Do[a[[m+1]]=(-2k/m) Sum[DivisorSigma[1,i] a[[m-i+1]],{i,1,m}],{m,1,n}];
  a];
(* 3. Fourier recurrence for an MLDE model.
 For a component q^r Sum[c_m q^m], ds[[j+1]] is the matrix of D_k^j
 through order n; the derivative weights increase by 2 at each step.
 Each Equation record is {j,a,b,u}: u E4^a E6^b D_k^j.
 ops[[h]] is the theta^(h-1) coefficient matrix of the complete operator.
 The diagonal gives the equation for c_m; earlier rows give its known RHS.
 A vanishing diagonal is a resonance, fixed by the exact draft seed.
 The returned array is component x Fourier order x field-basis coefficient.
 Models shared by different named vectors are memoized only once. *)
VVMFModelSeries[id_String,n_Integer] := VVMFModelSeries[id,n] = Module[ {f=$VVMFModels[id],k,rs,mod,
    seed,eq,degree,zero,e2,size,mono,convmat,result, r,ds,A,j,m,l,t,ops,c,n0,rhs,delta,next,row,basis},
  k=f["Weight"];
  rs=f["Exponents"];
  mod=f["Modulus"];
  seed=f["Seed"];
  eq=f["Equation"];
  degree=If[mod=={},1,Length[mod]-1];
  zero=ConstantArray[0,degree];
  size=n+1;
  If[Length[rs]==1,Return[{List/@VVMFEta[k,n]}]];
  basis=If[degree==1,{},Table[VVMFMultiplicationMatrix[UnitVector[degree,j],mod],{j,degree}]];
  e2=VVMFEisenstein[2,n];
  mono=Table[VVMFMonomial[t[[2]],t[[3]],n],{t,eq}];
  convmat=Table[Table[If[i>=j,mono[[t,i-j+1]],0],{i,size},{j,size}],{t,Length[eq]}];
  result=Table[ r=rs[[l]];
    ds={IdentityMatrix[size]};
    Do[A=Table[If[i<j,0,If[i==j,r+i-1-(k+2(m-1))/12, -(k+2(m-1))/12 e2[[i-j+1]]]],{i,size},{j,size}];
      AppendTo[ds,A.Last[ds]],{m,Length[rs]}];
    ops=Table[ConstantArray[0,{size,size}],{degree}];
    Do[A=convmat[[t]].ds[[eq[[t,1]]+1]];
      Do[ops[[j]]=ops[[j]]+eq[[t,4,j]] A,{j,degree}],{t,Length[eq]}];
    row=ConstantArray[zero,size];
    Do[delta=Table[ops[[j,n0+1,n0+1]],{j,degree}];
      rhs=If[n0==0,zero,If[degree==1, {Take[ops[[1,n0+1]],n0].Flatten[Take[row,n0]]}, Total[Table[basis[[j]].(Take[ops[[j,
          n0+1]],n0].Take[row,n0]),{j,degree}]]]];
      If[delta===zero, If[rhs=!=zero||n0>=Length[seed[[l]]],Return[Failure["Resonance",<|"Model"->id,
          "Component"->l,"Order"->n0|>]]];
        next=seed[[l,n0+1]], next=If[degree==1,-rhs/First[delta],LinearSolve[Sum[delta[[j]] basis[[j]],
          {j,degree}],-rhs]]];
      If[n0<Length[seed[[l]]]&&next=!=seed[[l,n0+1]], Return[Failure["SeedMismatch",<|"Model"->id,
          "Component"->l,"Order"->n0|>]]];
      row[[n0+1]]=next,{n0,0,n}];
    row, {l,Length[rs]}];
  result ];
(* 4. Exact algebraic embedding and draft normalization.
 The polynomial recurrence does not require a numerical field embedding.
 RootSelect returns an exact Root; the approximate target only selects it.
 Prefactors restore the component normalizations and phases of the draft. *)
VVMFKeyTake[a_Association,keys_List] := Association@@Table[k->a[k],{k,Select[keys,MemberQ[Keys[a],
        #]&]}];
VVMFFailureQ[e_] := MatchQ[e,_Failure];
VVMFPolynomialValue[v_List,z_] := First[v]+Sum[v[[j+1]] z^j,{j,1,Length[v]-1}];
VVMFRootSelect[poly_List,target_] := VVMFRootSelect[poly,target] = Module[{p=poly,roots,nearest,distances},
  roots=Table[Root[Evaluate[Sum[p[[j+1]] #^j,{j,0,Length[p]-1}]]&,i],{i,Length[p]-1}];
  distances=Table[Abs[N[roots[[j]],50]-N[target,50]],{j,Length[roots]}];
  nearest=First[First[Position[distances,Min[distances]]]];
  roots[[nearest]]];
VVMFParameters[id_String] := VVMFParameters[id] = Module[{f=$VVMFCatalogue[id],th,kap,alphas}, th=Switch[f["FieldKind"],
    "Q",0,"sqrt3",Sqrt[3],"eis",I Sqrt[3], "numberfield",VVMFRootSelect[f["RootPolynomial"],f["RootApproximation"]]];
  If[f["FieldKind"]!="numberfield",Return[<|"FieldValue"->th,"Prefactors"->f["Prefactors"]|>]];
  kap=(f["KappaFormula"]/.VVMFTheta->th);
  alphas={1,1};
  AppendTo[alphas,f["AlphaFormulas"][[1]]/.VVMFTheta->th];
  Do[AppendTo[alphas,f["AlphaFormulas"][[j-1]]/.{VVMFTheta->th,VVMFAlpha2->alphas[[3]]}],{j,3,5}];
  <|"FieldValue"->th,"Prefactors"->Table[alphas[[j+1]] kap^j,{j,0,5}]|> ];
(* 5. Data access.
 A stable ID is group|irrep|ordinal. The public Y... functions below use
 the same catalogue but have readable Mathematica symbol names. *)
VVMFResolve[group_String,rep_String,gen_String:"F"] := Module[{ids}, ids=Select[$VVMFOrder,($VVMFCatalogue[#]["Group"]==group&&$VVMFCatalogue[#]["Irrep"]==rep&&$VVMFCatalogue[#]["Generator"]==gen)&];
  If[Length[ids]==1,First[ids],Failure["UnknownOrAmbiguousGenerator",<|"Candidates"->ids,"Group"->group,
        "Irrep"->rep,"Generator"->gen|>]]];
VVMFList[] := Dataset[Table[VVMFKeyTake[$VVMFCatalogue[id],{"Section","Group","Irrep","Generator",
        "Weight","Dimension","ID"}],{id,$VVMFOrder}]];
VVMFList[group_String] := Dataset[Table[VVMFKeyTake[$VVMFCatalogue[id],{"Section","Group","Irrep",
        "Generator","Weight","Dimension","ID"}], {id,Select[$VVMFOrder,$VVMFCatalogue[#]["Group"]==group&]}]];
VVMFGet[id_String,n_Integer] := Module[{f,shape,p,c}, If[!MemberQ[Keys[$VVMFCatalogue],id],Return[Failure["UnknownID",
        <|"ID"->id|>]]];
  If[n<0,Return[Failure["NegativeOrder",<||>]]];
  f=$VVMFCatalogue[id];
  If[$VVMFMode=="Stored"&&n>$VVMFMaxOrder,Return[Failure["StoredOrder",<|"MaximumRelativeOrder"->$VVMFMaxOrder,"Use"->"VVMF_Compute.nb"|>]]];
  shape=If[$VVMFMode=="Stored",Map[Take[#,n+1]&,$VVMFStored[f["Model"]]],VVMFModelSeries[f["Model"],
      n]];
  If[VVMFFailureQ[shape],Return[shape]];
  p=VVMFParameters[id];
  c=Table[p["Prefactors"][[j]] VVMFPolynomialValue[#,p["FieldValue"]]&/@shape[[j]],{j,f["Dimension"]}];
  Join[VVMFKeyTake[f,{"ID","Section","Group","Irrep","Generator","Weight","Dimension","Exponents",
        "ParameterTeX"}], <|"Order"->n,"Coefficients"->c,"CoefficientPolynomials"->shape,"Prefactors"->p["Prefactors"],
      "FieldValue"->p["FieldValue"]|>] ];
VVMFGet[group_String,rep_String,gen_String,n_Integer] := With[{id=VVMFResolve[group,rep,gen]},
  If[VVMFFailureQ[id],id,VVMFGet[id,n]]];
(* 6. Construct component SeriesData expressions.
 Fractional q exponents use the denominator of r as the SeriesData step.
 Zero padding inserts only the allowed exponents r,r+1,...,r+n.
 The remainder is O(q^(r+n+1)); leading seed zeros are retained in data. *)
VVMFSeriesFromData[f_Association,q_] := Table[Module[{r=f["Exponents"][[j]],a=f["Coefficients"][[j]],
      b,c}, b=Denominator[r];
    c=ConstantArray[0,b(Length[a]-1)+1];
    Do[c[[1+b n]]=a[[n+1]],{n,0,Length[a]-1}];
    SeriesData[q,0,c,Numerator[r],Numerator[r]+b Length[a],b]],{j,f["Dimension"]}];
VVMFQExpansion[id_String,n_Integer,q_:Global`q] := Module[{f=VVMFGet[id,n]},If[VVMFFailureQ[f],
    f,VVMFSeriesFromData[f,q]]];
VVMFQExpansion[group_String,rep_String,gen_String,n_Integer,q_:Global`q] := With[{id=VVMFResolve[group,
      rep,gen]},If[VVMFFailureQ[id],id,VVMFQExpansion[id,n,q]]];
VVMFCoefficient[id_String,j_Integer,n_Integer] := VVMFGet[id,n]["Coefficients"][[j,n+1]];
VVMFComputeAll[n_Integer] := Association@@Table[id->VVMFGet[id,n],{id,$VVMFOrder}];
VVMFValidateSeeds[n_Integer] := Module[{checks}, checks=Table[With[{c=VVMFModelSeries[id,n],s=$VVMFModels[id]["Seed"]},
      !VVMFFailureQ[c]&&And@@Table[Take[c[[j]],Min[n+1,Length[s[[j]]]]]===Take[s[[j]],Min[n+1,Length[s[[j]]]]],
        {j,Length[s]}]],{id,Keys[$VVMFModels]}];
  <|"Models"->Length[checks],"Passed"->Count[checks,True],"AllPassed"->And@@checks|>];
(* 7. Optional descendants.
 The Serre derivative is D_k=q d/dq-k E2/12.
 ScalarMultiply multiplies by E4^a E6^b and adjusts the modular weight. *)
VVMFSerreDerivative[f_Association] := Module[{a=f["Coefficients"],r=f["Exponents"],k=f["Weight"],
    n=f["Order"],c,e2}, e2=VVMFEisenstein[2,n];
  c=Table[Table[(r[[j]]+m-k/12) a[[j,m+1]]- k/12 Sum[e2[[i+1]] a[[j,m-i+1]],{i,1,m}],{m,0,n}],{j,
      f["Dimension"]}];
  Join[VVMFKeyTake[f,Complement[Keys[f],{"CoefficientPolynomials","Prefactors","FieldValue","ParameterTeX"}]],
    <|"Weight"->k+2,"Coefficients"->c,"Generator"->"D("<>f["Generator"]<>")"|>]];
VVMFScalarMultiply[f_Association,a_Integer,b_Integer] /; a>=0&&b>=0 :=
Join[VVMFKeyTake[f,Complement[Keys[f],{"CoefficientPolynomials","Prefactors","FieldValue","ParameterTeX"}]],
  <|"Weight"->f["Weight"]+4a+6b,"Coefficients"->(VVMFConv[#,VVMFMonomial[a,b,f["Order"]],f["Order"]]&/@f["Coefficients"])|>];
(* 8. LaTeX for orders other than the stored default.
 This formats coefficients in the draft's field parameters. The default
 order-20 strings are read from the separate checked LaTeX table. *)
VVMFLaTeX[id_String,n_Integer] := Module[{f,shape,z,p,rows,poly,term,rr,j}, If[!MemberQ[Keys[$VVMFCatalogue],
      id]||n<0||($VVMFMode=="Stored"&&n>$VVMFMaxOrder),Return[Failure["InvalidLaTeXRequest",<|"ID"->id,"Order"->n|>]]];
  f=$VVMFCatalogue[id];
  shape=If[$VVMFMode=="Stored",Map[Take[#,n+1]&,$VVMFStored[f["Model"]]],VVMFModelSeries[f["Model"],
      n]];
  z=Switch[f["FieldKind"],"Q",0,"sqrt3",Sqrt[3],"eis",Symbol["VVMFFormatting`\[Sigma]"],"numberfield",
    Symbol["VVMFFormatting`\[Theta]"]];
  p=If[f["FieldKind"]=="numberfield",Table[If[j<2,1,Subscript[Symbol["VVMFFormatting`\[Alpha]"],j]] Symbol["VVMFFormatting`\[Kappa]"]^j,
      {j,0,5}],f["Prefactors"]];
  rows=Table[poly=Sum[VVMFPolynomialValue[shape[[j,m+1]],z] Global`q^m,{m,0,n}];
    term=ToString[TeXForm[p[[j]] Global`q^f["Exponents"][[j]] poly]];
    term<>"+\\mathcal{O}\\!\\left(q^{"<>ToString[TeXForm[f["Exponents"][[j]]+n+1]]<>"}\\right)",{j,
      f["Dimension"]}];
  term=If[Length[rows]==1,First[rows],"\\begin{pmatrix}\n"<>StringRiffle[rows," \\\\\n"]<>"\n\\end{pmatrix}"];
  If[f["ParameterTeX"]=="",term,"\\begin{gathered}\n"<>f["ParameterTeX"]<>" \\\\[0.6em]\n"<>term<>"\n\\end{gathered}"] ];



(* Public access. The default order follows the loaded data file. *)
ClearAll[VVMFInfo,VVMFNames,VVMFNamedExpansion,VVMFResults,VVMFAll,
  VVMFComputeAll,VVMFTeX,VVMFStatus,VVMFInstallNames];
VVMFGet[id_String] := VVMFGet[id,$VVMFMaxOrder];
VVMFGet[group_String,rep_String,gen_String] := VVMFGet[group,rep,gen,$VVMFMaxOrder];
VVMFQExpansion[id_String] := VVMFQExpansion[id,$VVMFMaxOrder,Global`q];
VVMFQExpansion[group_String,rep_String,gen_String] :=
  VVMFQExpansion[group,rep,gen,$VVMFMaxOrder,Global`q];
VVMFLaTeX[id_String] := VVMFLaTeX[id,$VVMFMaxOrder];
VVMFNames[key_String:""] := If[key=="",$VVMFNames,
  If[MemberQ[Keys[$VVMFNameIndex],key],$VVMFNameIndex[key],
    Select[$VVMFNames,StringContainsQ[#,key]&]]];
VVMFInfo[name_String] := If[MemberQ[$VVMFNames,name],
  Join[<|"Name"->name|>,$VVMFCatalogue[$VVMFNameToID[name]]],
  Failure["UnknownName",<|"Name"->name|>]];
VVMFNamedExpansion::q = "Use an unassigned q symbol; evaluate Clear[q] if needed.";
VVMFNamedExpansion[name_String,qsym_Symbol,n_Integer] :=
  If[MemberQ[$VVMFNames,name],VVMFQExpansion[$VVMFNameToID[name],n,qsym],
    Failure["UnknownName",<|"Name"->name|>]];
VVMFNamedExpansion[name_String,qsym_,n_Integer] :=
  (Message[VVMFNamedExpansion::q];$Failed);
VVMFResults[key_String:"",n_Integer:-1,qsym_:Global`q] := Module[{order},
  order=If[n==-1,$VVMFMaxOrder,n];
  Association@@Table[name->VVMFNamedExpansion[name,qsym,order],
    {name,VVMFNames[key]}]
];
VVMFAll[] := VVMFResults[];
VVMFAll[n_Integer] := VVMFResults["",n];
VVMFComputeAll[n_Integer,qsym_:Global`q] := VVMFResults["",n,qsym];
VVMFTeX[name_String] := VVMFTeX[name,$VVMFMaxOrder];
VVMFTeX[name_String,n_Integer] := Module[{text,rules},
  If[!MemberQ[$VVMFNames,name],Return[Failure["UnknownName",<|"Name"->name|>]]];
  text=VVMFLaTeX[$VVMFNameToID[name],n];
  If[Head[text]=!=String,Return[text]];
  rules={ToString[TeXForm[Symbol["VVMFFormatting`\[Sigma]"]]]->"\\sigma",
    ToString[TeXForm[Symbol["VVMFFormatting`\[Theta]"]]]->"\\theta",
    ToString[TeXForm[Symbol["VVMFFormatting`\[Alpha]"]]]->"\\alpha",
    ToString[TeXForm[Symbol["VVMFFormatting`\[Kappa]"]]]->"\\kappa"};
  StringReplace[text,rules]
];
VVMFStatus[] := <|"Ready"->True,"Version"->6,"Order"->$VVMFMaxOrder,
  "Vectors"->Length[$VVMFNames],"Models"->Length[$VVMFModels],"Mode"->$VVMFMode|>;
VVMFInstallNames[] := Scan[
  Function[name,With[{symbol=Symbol["Global`"<>name],key=name,order=$VVMFMaxOrder},
    ClearAll[symbol];
    symbol[qsym_,n_Integer:order] := VVMFNamedExpansion[key,qsym,n];
    symbol[] := VVMFNamedExpansion[key,Global`q,$VVMFMaxOrder]
  ]],$VVMFNames
];

