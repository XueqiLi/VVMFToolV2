$VVMFAPINames={"VVMFKeyTake","VVMFFailureQ","VVMFPolynomialValue","VVMFRootSelect","VVMFParameters","VVMFResolve","VVMFList","VVMFGet","VVMFSeriesFromData","VVMFQExpansion","VVMFCoefficient","VVMFSerreDerivative","VVMFScalarMultiply","VVMFEisenstein","VVMFMonomial","VVMFConv","VVMFInfo","VVMFNames","VVMFNamedExpansion","VVMFResults","VVMFAll","VVMFComputeAll","VVMFTeX","VVMFStatus","VVMFLaTeX"};

(* Put stores Wolfram Language input, not a display rendering.
   Re-read the temporary file before replacing the previous result. *)
ClearAll[VVMFWriteData];
VVMFWriteData[payload_Association,path_String] := Module[{temporary,readback,written},
  temporary=StringJoin[path,".tmp"];
  Quiet[Put[payload,temporary]];
  If[!FileExistsQ[temporary],Return[Failure["WriteFailed",<|"File"->temporary|>]]];
  readback=Quiet[Get[temporary]];
  If[readback=!=payload,
    If[FileExistsQ[temporary],DeleteFile[temporary]];
    Return[Failure["RoundTripFailed",<|"File"->path,
      "Action"->"The existing data file has not been replaced."|>]]
  ];
  If[FileExistsQ[path],
    Quiet[DeleteFile[path]];
    If[FileExistsQ[path],Return[Failure["ReplaceFailed",<|"File"->path|>]]]
  ];
  written=Quiet[RenameFile[temporary,path]];
  If[!StringQ[written]||!FileExistsQ[path],
    Return[Failure["RenameFailed",<|"File"->path,"TemporaryFile"->temporary|>]]];
  path
];
ClearAll[VVMFBuild];
VVMFBuild[n_Integer,directory_String] := Module[
  {models,arrays,shape,payload,path,written,total=0},
  If[n<0,Return[Failure["Order",<|"Minimum"->0|>]]];
  $VVMFMaxOrder=n;
  $VVMFMode="Compute";
  VVMFInstallNames[];
  models=Keys[$VVMFModels];
  Print["Computing ",Length[models]," models to relative order ",n,"..."];
  arrays=Association@@Table[
    shape=VVMFModelSeries[id,n];
    If[Head[shape]===Failure,Return[shape]];
    total++;
    If[Mod[total,20]==0,Print[total," / ",Length[models]]];
    id->shape,{id,models}
  ];
  (* Only data are stored. Reader definitions live in VVMF_Results.nb. *)
  payload=<|"FormatVersion"->2,"Order"->n,"SourceSHA256"->$VVMFSourceSHA256,
    "Catalogue"->$VVMFCatalogue,"Models"->$VVMFModels,"IDs"->$VVMFOrder,
    "Names"->$VVMFNames,"NameToID"->$VVMFNameToID,
    "IDToName"->$VVMFIDToName,"NameIndex"->$VVMFNameIndex,
    "Coefficients"->arrays|>;
  path=FileNameJoin[{directory,"VVMF_Results_Data.wl"}];
  written=VVMFWriteData[payload,path];
  If[Head[written]===Failure,Return[written]];
  <|"File"->path,"Order"->n,"Vectors"->Length[$VVMFNames],
    "Models"->Length[arrays],"RoundTripVerified"->True|>
];

VVMFInstallNames[];
